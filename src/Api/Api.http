@ApiService_HostAddress = https://localhost:7467

# @name login
POST {{ApiService_HostAddress}}/api/v1/auth/login?useCookies=false
Content-Type: application/json

{
  "email": "<Email>",
  "password": "<Password>"
}

###

@authToken = {{login.response.body.$.accessToken}}

# @name getAccountInfo
GET {{ApiService_HostAddress}}/api/v1/account/info
Authorization: Bearer {{authToken}}
Accept: application/json
