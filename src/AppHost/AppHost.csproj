<Project Sdk="Aspire.AppHost.Sdk/13.5.3">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<UserSecretsId>6b523255-b779-4aba-a928-e0893ab4509e</UserSecretsId>
		<AspireUseCliBundle>true</AspireUseCliBundle>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Api\Api.csproj" />
		<ProjectReference Include="..\DbMigrator\DbMigrator.csproj" />
		<ProjectReference Include="..\Web\Web.csproj" />
		<ProjectReference Include="..\ServiceDefaults\ServiceDefaults.csproj" IsAspireProjectResource="false" />
	</ItemGroup>

	<ItemGroup>
		<!-- Core hosting dependency required to match SDK 13.5.3 -->
		<PackageReference Include="Aspire.Hosting.AppHost" />
		<PackageReference Include="Aspire.Hosting.Azure.AppConfiguration" />
		<PackageReference Include="Aspire.Hosting.Azure.KeyVault" />
		<PackageReference Include="Aspire.Hosting.Azure.Storage" />
		<PackageReference Include="Aspire.Hosting.PostgreSQL" />
		<PackageReference Include="Aspire.Hosting.Redis" />
		<PackageReference Include="AzureKeyVaultEmulator.Aspire.Hosting" />
		<PackageReference Include="CommunityToolkit.Aspire.Hosting.Ollama" />
		<PackageReference Include="MessagePack" />
	</ItemGroup>
</Project>
