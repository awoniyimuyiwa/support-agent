@using Microsoft.AspNetCore.Components.Authorization
@using Web.Client.Components
@using Web.Client.Layout

@inject IJSRuntime JS
@inject ApiClient ApiClient
@inject ILogger<Routes> Logger

@*
  Do not wrap components in a <CascadingAuthenticationState> markup tag here or in MainLayout.
  Instead, the cascading state container task is registered globally via the background service layer
  (builder.Services.AddCascadingAuthenticationState()) in both Server and WebAssembly Program.cs pipelines.
  
  This prevents nested duplicate cascade conflicts and synchronization loops across the runtime, 
  while ensuring that AuthorizeView components across all assemblies cleanly resolve user security contexts.
*@
<Router AppAssembly="typeof(Routes).Assembly">
    <Found Context="routeData">        
        <ErrorBoundary @ref="_errorBoundary">
            <ChildContent>
                <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
                    <NotAuthorized>
                        <RedirectToLogin />
                    </NotAuthorized>

                    <Authorizing>
                        <div class="d-flex flex-column align-items-center justify-content-center text-center p-5 my-5">
                            <div class="spinner-border text-primary" role="status"></div>
                            <p class="mt-3 text-secondary small fw-medium">Verifying user security context...</p>
                        </div>
                    </Authorizing>
                </AuthorizeRouteView>
            </ChildContent>
            
            <ErrorContent Context="exception">
                <!-- Rendered for any unhandled component/action crash -->
                <LayoutView Layout="typeof(MainLayout)">
                    <div class="p-4 m-4 card border-danger bg-danger-subtle text-danger-emphasis shadow-sm animate-fade-in font-sans-serif">
                        <h4 class="fw-bold d-flex align-items-center gap-2 m-0 text-danger">
                            <span class="bi bi-exclamation-octagon-fill"></span> Application Error Intercepted
                        </h4>
                        <p class="small my-2">An error occured</p>
                        <button type="button" class="btn btn-danger btn-sm fw-semibold mt-1" @onclick="RecoverFromError">
                            <span class="bi bi-arrow-clockwise"></span> Reset View Context
                        </button>
                    </div>
                </LayoutView>
            </ErrorContent>
        </ErrorBoundary>

        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        @* 
          This is a dead-code container because Fallback404.razor 
          handles everything. Minimal to fulfill Router requirements.
        *@
        <PageTitle>Page Not Found</PageTitle>
        <LayoutView Layout="typeof(MainLayout)">
            <div class="text-center p-5">
                <p class="text-secondary">Route unhandled by catch-all sequence.</p>
            </div>
        </LayoutView>
    </NotFound>
</Router>

@code {
    private ErrorBoundary? _errorBoundary;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && OperatingSystem.IsBrowser())
        {
            await EnsureAntiforgeryToken();
        }
    }

    protected override void OnParametersSet()
    {
        RecoverFromError();
    }

    /// <summary>
    /// Checks if the browser's antiforgery cookie is missing (e.g., after a browser restart
    /// cleared session cookies while the persistent auth cookie survived) and seeds a fresh one.
    ///
    /// ARCHITECTURAL NOTE:
    /// 400 Bad Request retry interceptors for mid-session token expiry is intetionally not imlemented.
    /// ASP.NET Core Data Protection keys default to a 90-day lifetime, so keeping the pipeline simple
    /// and letting a standard page refresh resolve rare mid-session expirations avoids unnecessary complexity.
    /// </summary>
    private async Task EnsureAntiforgeryToken()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("getAntiforgeryToken");

            if (string.IsNullOrWhiteSpace(token))
            {
                Logger.LogInformation("Antiforgery cookie missing on WASM initialization. Seeding fresh tokens from API...");
                using var _ = await ApiClient.GetAntiforgeryToken();
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning("Antiforgery token fetching failed during startup: {Message}", ex.Message);
        }
    }

    private void RecoverFromError()
    {
        // Clears crash state when the user moves to a different page
        _errorBoundary?.Recover();
    }
}
