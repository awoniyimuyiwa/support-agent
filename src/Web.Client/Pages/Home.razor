@page "/"
@rendermode InteractiveAuto
@attribute [AllowAnonymous]
@layout EmptyLayout

@using Microsoft.AspNetCore.Authorization
@using Web.Client.Extensions

<div class="landing-wrapper position-relative overflow-hidden min-vh-100 bg-light">
    <!-- Premium Ambient Background Blur Nodes -->
    <div class="glow-orb orb-1"></div>
    <div class="glow-orb orb-2"></div>

    <!-- 🌐 Nav Bar -->
    <nav class="navbar navbar-expand-lg navbar-glass py-3 px-4 mb-5 border-bottom border-white-50">
        <div class="container-fluid max-width-container d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <div class="bg-primary text-white rounded-3 p-2 d-flex align-items-center justify-content-center shadow-sm brand-icon">
                    <span class="bi bi-shield-shaded fs-5"></span>
                </div>
                <span class="fs-5 fw-bold text-dark tracking-tight">Efmal<span class="text-primary">Desk</span></span>
            </div>
            <div class="d-flex align-items-center gap-3">
                <AuthorizeView>
                    <NotAuthorized>
                        <!-- Only visible to guests -->
                        <a href="/login" class="btn btn-link text-secondary fw-semibold text-decoration-none btn-sm px-3">Sign In</a>
                        <a href="/tickets" class="btn btn-primary fw-semibold btn-sm px-4 py-2 rounded-3 shadow-sm custom-nav-btn">
                            Launch App <span class="bi bi-arrow-right ms-1"></span>
                        </a>
                    </NotAuthorized>
                    <Authorized>
                        <!-- Only visible when logged in -->
                        <span class="small text-secondary me-2 d-none d-sm-inline">Logged in as @context.User.Identity?.Name</span>

                        @{
                            var targetRoute = context.User.IsAdmin ? "/admin" : "/dashboard";
                        }

                        <a href="@targetRoute" class="btn btn-primary fw-semibold btn-sm px-4 py-2 rounded-3 shadow-sm custom-nav-btn">
                            Go to Dashboard <span class="bi bi-speedometer2 ms-1"></span>
                        </a>
                    </Authorized>
                </AuthorizeView>
            </div>
        </div>
    </nav>

    <!-- 🚀 Hero Section -->
    <div class="container position-relative z-1 mb-4">
        <div class="row justify-content-center text-center pt-5">
            <div class="col-12 col-lg-9 col-xl-8">
                <!-- Inline Micro Badge -->
                <div class="d-inline-flex align-items-center gap-2 bg-white border border-light-subtle rounded-pill px-3 py-1.5 mb-4 shadow-xs">
                    <span class="badge bg-primary-subtle text-primary rounded-pill fw-bold">NEW</span>
                    <small class="text-secondary fw-medium">WASM SQLite Offline Sync Core is now live</small>
                </div>

                <!-- Main Header -->
                <h1 class="display-3 fw-extrabold text-dark tracking-tight mb-3 lh-sm">
                    The ultra-fast workspace for <span class="text-gradient">Support Agents</span>
                </h1>

                <!-- Supporting Copy -->
                <p class="fs-5 text-secondary font-sans font-normal mb-5 px-md-5 lh-base">
                    Manage client communications, track customer telemetry, and securely sync ticket metrics perfectly—even when your internet connectivity drops.
                </p>

                <!-- Call to Action Actions -->
                <div class="d-flex flex-wrap align-items-center justify-content-center gap-3 mb-5">
                    <AuthorizeView>
                        <Authorized>
                            @{
                                var heroRoute = context.User.IsAdmin ? "/admin" : "/dashboard";
                            }
                            <a href="@heroRoute" class="btn btn-dark btn-lg px-4 py-3 fw-bold rounded-3 shadow d-inline-flex align-items-center gap-2 transition-all">
                                <span class="bi bi-speedometer2"></span> Enter Dashboard
                            </a>
                        </Authorized>
                        <NotAuthorized>
                            <a href="/dashboard" class="btn btn-dark btn-lg px-4 py-3 fw-bold rounded-3 shadow d-inline-flex align-items-center gap-2 transition-all">
                                <span class="bi bi-speedometer2"></span> Enter Dashboard
                            </a>
                        </NotAuthorized>
                    </AuthorizeView>
                    <a href="/tickets" class="btn btn-white border border-gray-200 btn-lg px-4 py-3 fw-bold rounded-3 shadow-sm d-inline-flex align-items-center gap-2 bg-white transition-all">
                        View Active Queue
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- 🤖 Live AI Ticket Processing Pipeline Animation -->
    <div class="container max-width-container mb-5 position-relative z-1">
        <div class="ai-pipeline-card border border-light-subtle rounded-4 p-4 bg-white shadow-lg mx-auto overflow-hidden"
             style="max-width: 880px;">

            <!-- Header Bar -->
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 pb-3 mb-4 border-bottom border-light-subtle">
                <div class="d-flex align-items-center gap-2">
                    <span class="pulse-dot"></span>
                    <span class="fw-bold text-dark small">Autonomous Triage &amp; Sync Engine</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary-subtle text-primary rounded-pill px-2.5 py-1 small">
                        <i class="bi bi-robot me-1"></i> 2 AI Agents Active
                    </span>
                    <span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1 small">
                        <i class="bi bi-check-circle-fill me-1"></i> SQLite Sync Ready
                    </span>
                </div>
            </div>

            <!-- Animated 3-Stage Pipeline -->
            <div class="row align-items-center g-3 text-center position-relative">

                <!-- Stage 1: Incoming Queue -->
                <div class="col-12 col-md-4">
                    <div class="p-3 rounded-3 bg-light border border-light-subtle position-relative">
                        <div class="text-uppercase text-muted fw-bold mb-2" style="font-size: 0.68rem; letter-spacing: 0.05em;">
                            1. Incoming Queue
                        </div>
                        <div class="d-flex flex-column gap-2">
                            <div class="ticket-pill ticket-1 bg-white border rounded-2 px-2.5 py-1.5 d-flex align-items-center justify-content-between shadow-xs">
                                <span class="small fw-semibold text-dark"><i class="bi bi-ticket-perforated text-warning me-1"></i>#TK-1048</span>
                                <span class="badge bg-warning-subtle text-warning-emphasis" style="font-size: 0.65rem;">Triaging</span>
                            </div>
                            <div class="ticket-pill ticket-2 bg-white border rounded-2 px-2.5 py-1.5 d-flex align-items-center justify-content-between shadow-xs">
                                <span class="small fw-semibold text-dark"><i class="bi bi-ticket-perforated text-primary me-1"></i>#TK-1049</span>
                                <span class="badge bg-secondary-subtle text-secondary" style="font-size: 0.65rem;">Queued</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Stage 2: AI Robot Core -->
                <div class="col-12 col-md-4">
                    <div class="p-3 rounded-4 border border-primary-subtle position-relative mx-auto"
                         style="background: linear-gradient(145deg, #f0f7ff 0%, #ffffff 100%);">
                        <!-- Animated Conveyor Track -->
                        <div class="conveyor-line d-none d-md-block"></div>

                        <!-- Animated AI Robot SVG -->
                        <div class="robot-float mx-auto mb-2 d-flex align-items-center justify-content-center rounded-circle bg-primary text-white shadow"
                             style="width: 64px; height: 64px;">
                            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="11" width="18" height="10" rx="2" />
                                <circle cx="12" cy="5" r="2" />
                                <path d="M12 7v4" />
                                <line class="robot-eye" x1="8" y1="16" x2="8" y2="16" stroke-width="3" />
                                <line class="robot-eye" x1="16" y1="16" x2="16" y2="16" stroke-width="3" />
                            </svg>
                        </div>

                        <div class="fw-bold text-dark small">AI Support Core</div>
                        <div class="text-primary fw-medium scanning-text" style="font-size: 0.72rem;">
                            Analyzing &amp; drafting fix...
                        </div>
                    </div>
                </div>

                <!-- Stage 3: Resolved & Synced -->
                <div class="col-12 col-md-4">
                    <div class="p-3 rounded-3 bg-light border border-light-subtle">
                        <div class="text-uppercase text-muted fw-bold mb-2" style="font-size: 0.68rem; letter-spacing: 0.05em;">
                            3. Resolved &amp; Synced
                        </div>
                        <div class="d-flex flex-column gap-2">
                            <div class="resolved-pill bg-white border border-success-subtle rounded-2 px-2.5 py-1.5 d-flex align-items-center justify-content-between shadow-xs">
                                <span class="small fw-semibold text-dark"><i class="bi bi-check-circle-fill text-success me-1"></i>#TK-1047</span>
                                <span class="badge bg-success-subtle text-success" style="font-size: 0.65rem;">Synced</span>
                            </div>
                            <div class="bg-white border border-success-subtle rounded-2 px-2.5 py-1.5 d-flex align-items-center justify-content-between shadow-xs">
                                <span class="small fw-semibold text-dark"><i class="bi bi-check-circle-fill text-success me-1"></i>#TK-1046</span>
                                <span class="badge bg-success-subtle text-success" style="font-size: 0.65rem;">Synced</span>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    
    <!-- 🏷️ Core Operational Value Pillars -->
    <div class="container position-relative z-1 mb-5 max-width-container">
        <div class="row g-4 justify-content-center">
            <div class="col-12 col-md-4">
                <div class="glass-card p-4 rounded-4 shadow-sm border border-white-50 h-100 d-flex align-items-start gap-3">
                    <div class="text-primary mt-1"><span class="bi bi-lightning-charge-fill fs-4"></span></div>
                    <div>
                        <h6 class="fw-bold text-dark mb-1">Instant Execution</h6>
                        <p class="small text-secondary mb-0">WASM database interaction processes changes locally without network lag.</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="glass-card p-4 rounded-4 shadow-sm border border-white-50 h-100 d-flex align-items-start gap-3">
                    <div class="text-success mt-1"><span class="bi bi-shield-check fs-4"></span></div>
                    <div>
                        <h6 class="fw-bold text-dark mb-1">Deterministic Sync</h6>
                        <p class="small text-secondary mb-0">Built-in concurrency stamp tracking ensures zero broken record states downstream.</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="glass-card p-4 rounded-4 shadow-sm border border-white-50 h-100 d-flex align-items-start gap-3">
                    <div class="text-info mt-1"><span class="bi bi-window-sidebar fs-4"></span></div>
                    <div>
                        <h6 class="fw-bold text-dark mb-1">Unified Interface</h6>
                        <p class="small text-secondary mb-0">Seamless transition between supervisor insights and individual workflows.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ⚡ Features Showcase Section -->
    <div class="container position-relative z-1 py-5 max-width-container">
        <div class="row g-4">
            <!-- Feature 1 -->
            <div class="col-12 col-md-6 col-lg-4">
                <div class="p-4 bg-white rounded-4 border border-light-subtle shadow-xs h-100 transition-all hover-translate">
                    <div class="feature-icon-wrapper bg-primary-subtle text-primary rounded-3 mb-3 d-inline-flex align-items-center justify-content-center shadow-xs">
                        <span class="bi bi-wifi-off fs-4"></span>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Offline-First Engine</h5>
                    <p class="text-secondary small mb-0 lh-base">
                        Keep modifying tickets and records offline. Changes are saved automatically inside an isolated SQLite WASM sandbox layer.
                    </p>
                </div>
            </div>

            <!-- Feature 2 -->
            <div class="col-12 col-md-6 col-lg-4">
                <div class="p-4 bg-white rounded-4 border border-light-subtle shadow-xs h-100 transition-all hover-translate">
                    <div class="feature-icon-wrapper bg-success-subtle text-success rounded-3 mb-3 d-inline-flex align-items-center justify-content-center shadow-xs">
                        <span class="bi bi-cloud-check-fill fs-4"></span>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Background Reconciliation</h5>
                    <p class="text-secondary small mb-0 lh-base">
                        The application automatically discovers downstream connection updates and safely resolves concurrency conflicts with zero UI blockages.
                    </p>
                </div>
            </div>

            <!-- Feature 3 -->
            <div class="col-12 col-md-6 col-lg-4">
                <div class="p-4 bg-white rounded-4 border border-light-subtle shadow-xs h-100 transition-all hover-translate">
                    <div class="feature-icon-wrapper bg-info-subtle text-info rounded-3 mb-3 d-inline-flex align-items-center justify-content-center shadow-xs">
                        <span class="bi bi-activity fs-4"></span>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Agent Performance Telemetry</h5>
                    <p class="text-secondary small mb-0 lh-base">
                        Review direct real-time productivity blocks, session counts, closed tickets logs, and active queues directly inside a unified view.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

