@page "/tickets"
@rendermode InteractiveAuto
@attribute [Authorize]
@layout MainLayout

@using Microsoft.AspNetCore.Authorization
@using Web.Client.Components

<CustomPageTitle Value="Tickets" />

<div class="p-4 animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-info-subtle text-info-emphasis rounded p-2.5 d-inline-flex align-items-center justify-content-center shadow-sm">
                <span class="bi bi-ticket-perforated-fill fs-3"></span>
            </div>
            <div>
                <h1 class="h3 fw-bold mb-0">Tickets</h1>
                <small class="text-secondary">Manage, track, and resolve active customer support cases</small>
            </div>
        </div>
        <div>
            <button class="btn btn-primary d-flex align-items-center gap-2 shadow-sm fw-semibold" @onclick="CreateDummyTicket">
                <span class="bi bi-plus-circle"></span>
                <span>New Ticket</span>
            </button>
        </div>
    </div>

    <!-- Live Data Grid Simulation -->
    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small text-uppercase">
                    <tr>
                        <th class="ps-4" style="width: 120px;">ID</th>
                        <th>Subject</th>
                        <th>Customer</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th class="pe-4 text-end" style="width: 140px;">Actions</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @if (_tickets.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center p-5 text-muted">
                                <span class="bi bi-folder-x fs-1 d-block mb-2 text-secondary opacity-50"></span>
                                No tickets assigned to your workspace tier yet.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var ticket in _tickets)
                        {
                            <tr class="animate-fade-in">
                                <td class="ps-4 fw-mono text-secondary">#@ticket.Id.ToString()[..8]</td>
                                <td class="fw-semibold text-dark">@ticket.Subject</td>
                                <td>@ticket.CustomerEmail</td>
                                <td>
                                    <span class="badge @GetPriorityClass(ticket.Priority) rounded-pill px-2.5 py-1">
                                        @ticket.Priority
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @GetStatusClass(ticket.Status) rounded-pill px-2.5 py-1">
                                        @ticket.Status
                                    </span>
                                </td>
                                <td class="pe-4 text-end">
                                    <button class="btn btn-outline-secondary btn-sm border-0" title="View details">
                                        <span class="bi bi-pencil-square"></span>
                                    </button>
                                    <button class="btn btn-outline-danger btn-sm border-0" @onclick="() => DeleteTicket(ticket.Id)" title="Delete case">
                                        <span class="bi bi-trash3"></span>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<TicketDto> _tickets = [];

    protected override void OnInitialized()
    {
        // Hydrate with premium mocked enterprise case data logs
        _tickets = [
            new(Guid.NewGuid(), "Cannot decrypt API responses over TLS 1.3 backplane", "cto@alpha-enterprise.com", "Critical", "Open"),
            new(Guid.NewGuid(), "Redis Output cache evicting tagged rows early on cluster restart", "dev-ops@cloudscale.io", "High", "In-Progress"),
            new(Guid.NewGuid(), "Missing Antiforgery handshake tokens blocking mobile app API fetches", "lead-mobile@fintech-core.net", "Medium", "Open"),
            new(Guid.NewGuid(), "Billing invoice PDF download rendering with garbled localized symbols", "accounting@retail-global.org", "Low", "Resolved")
        ];
    }

    private void CreateDummyTicket()
    {
        var randomIssues = new[] {
            "YARP reverse proxy returning 502 bad gateway during spike hours",
            "X.509 certificate expiry warning script throwing null reference exception",
            "Database connection pool exhaustion detected under auto-scaling routines"
        };
        var randomCustomers = new[] { "admin@node-tech.io", "security-audit@bank-vault.com", "operations@saas-fleet.cc" };
        var randomPriorities = new[] { "Critical", "High", "Medium", "Low" };
        
        var random = new Random();
        var newTicket = new TicketDto(
            Guid.NewGuid(),
            randomIssues[random.Next(randomIssues.Length)],
            randomCustomers[random.Next(randomCustomers.Length)],
            randomPriorities[random.Next(randomPriorities.Length)],
            "Open"
        );

        _tickets.Insert(0, newTicket);
    }

    private void DeleteTicket(Guid id)
    {
        _tickets.RemoveAll(t => t.Id == id);
    }

    private string GetPriorityClass(string priority) => priority switch
    {
        "Critical" => "bg-danger-subtle text-danger border border-danger-subtle",
        "High" => "bg-warning-subtle text-warning-emphasis border border-warning-subtle",
        "Medium" => "bg-primary-subtle text-primary-emphasis border border-primary-subtle",
        _ => "bg-secondary-subtle text-secondary border border-secondary-subtle"
    };

    private string GetStatusClass(string status) => status switch
    {
        "Open" => "bg-success-subtle text-success-emphasis",
        "In-Progress" => "bg-info-subtle text-info-emphasis",
        _ => "bg-light text-secondary border"
    };

    private record TicketDto(
        Guid Id, 
        string Subject,
        string CustomerEmail,
        string Priority, 
        string Status);
}
