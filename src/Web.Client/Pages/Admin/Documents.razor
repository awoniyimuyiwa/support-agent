@page "/admin/documents"
@rendermode InteractiveAuto
@attribute [Authorize(Roles = Domain.Shared.Constants.AdminRoleName)]
@layout MainLayout

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using SqliteWasmHelper
@using Web.Client.Components
@using Web.Client.Data
@using Web.Client.Extensions
@using Web.Client.Models
@using Web.Client.Services

@inject ISqliteWasmDbContextFactory<ApplicationDbContext> DbContextFactory
@inject ILogger<Documents> Logger
@inject SyncStateProvider SyncState
@inject TimeProvider TimeProvider

@implements IDisposable

<CustomPageTitle Value="Documents" />

<div class="p-4 animate-fade-in">
    <PageHeader Title="Document Management" Subtitle="Maintain enterprise files, index schemas, and document binaries" IconClass="bi-file-earmark-text-fill">
        <ActionContent>
            <button class="btn btn-primary d-flex align-items-center gap-2 shadow-sm fw-semibold" @onclick="OpenCreateModal">
                <span class="bi bi-cloud-upload-fill"></span> Upload Document
            </button>
        </ActionContent>
    </PageHeader>

    <!-- Search, Filter & Sort Control Panel -->
    <div class="card border-0 shadow-sm p-3 mb-4 bg-light">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-lg-12 col-xl">
                <label class="form-label small fw-bold text-secondary text-uppercase">Search</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><span class="bi bi-search"></span></span>
                    <input type="text" class="form-control border-start-0" placeholder="Search documents by name..."
                           value="@_filter.SearchTerm" @oninput="OnSearchInputDebounced" />
                </div>
            </div>

            <div class="col-6 col-lg-4 col-xl-3">
                <label class="form-label small fw-bold text-secondary text-uppercase">Category</label>
                <select class="form-select" @bind="_filter.CategoryId" @bind:after="ResetPage">
                    <option value="">Categories</option>
                    @foreach (var cat in _categories)
                    {
                        <option value="@cat.Id">@cat.Name</option>
                    }
                </select>
            </div>

            <div class="col-6 col-lg-4 col-xl-3">
                <label class="form-label small fw-bold text-secondary text-uppercase text-nowrap">Sync Status</label>
                <select class="form-select" @bind="_filter.SyncStatus" @bind:after="ResetPage">
                    <option value="">Sync States</option>
                    @foreach (var syncStatus in VisibleSyncStatuses)
                    {
                        <option value="@syncStatus">@syncStatus.DisplayName</option>
                    }
                </select>
            </div>

            <div class="col-12 col-lg-4 col-xl-auto">
                <button type="button"
                        class="btn btn-outline-secondary w-100 fw-semibold d-flex align-items-center justify-content-center gap-2 text-nowrap"
                        @onclick="ToggleSortDirection">
                    <span class="bi @(_filter.SortDescending ? "bi-sort-down-alt" : "bi-sort-up")"></span>
                    <span>@(_filter.SortDescending ? "Descending" : "Ascending")</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Data Grid -->
    <div class="card border-0 shadow-sm overflow-hidden mb-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small text-uppercase text-nowrap">
                    <tr>
                        <th class="ps-4" style="min-width: 180px;">Name</th>
                        <th style="min-width: 140px;">Category</th>
                        <th style="width: 175px;">Latest Version Hash</th>
                        <th style="width: 165px;">Created At</th>
                        <th style="width: 130px;">Sync State</th>
                        <th class="pe-4 text-end" style="width: 140px;">Actions</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @if (_documents.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center p-5 text-muted">
                                <span class="bi bi-folder-x fs-1 d-block mb-2 text-secondary opacity-50"></span>
                                <span class="fw-semibold d-block">No documents found.</span>
                                <span class="small">Try adjusting your search or filter, or create a new document.</span>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var doc in _documents)
                        {
                            <tr class="animate-fade-in @(!string.IsNullOrWhiteSpace(doc.SerializedErrors) ? "table-danger border-start border-danger border-3" : "")">
                                <td class="ps-4 fw-bold text-dark">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="text-truncate" style="max-width: 240px;" title="@doc.Name">@doc.Name</span>
                                        @if (!string.IsNullOrWhiteSpace(doc.SerializedErrors))
                                        {
                                            <span class="badge bg-danger text-white flex-shrink-0" title="Sync Rejected">Error</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-secondary text-nowrap">@(doc.DocumentCategory?.Name ?? "Unassigned")</td>
                                <td class="text-nowrap">
                                    <span class="badge bg-light text-secondary border font-monospace px-2">
                                        @(_latestVersionMap.TryGetValue(doc.Id, out var hash) ? hash[..8] + "..." : "No versions")
                                    </span>
                                </td>
                                <td class="text-secondary text-nowrap">@doc.CreatedAt.ToLocalTime().ToString("g")</td>
                                <td class="text-nowrap">
                                    @if (!string.IsNullOrWhiteSpace(doc.SerializedErrors))
                                    {
                                        <span class="badge bg-danger text-white border-0">Sync Error</span>
                                    }
                                    else if (doc.SyncStatus == SyncStatus.PendingInsert || doc.SyncStatus == SyncStatus.PendingUpdate)
                                    {
                                        <span class="badge bg-info text-dark border">
                                            <span class="spinner-border spinner-border-sm me-1" style="width: 0.7rem; height: 0.7rem;"></span> Queued
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-dark-subtle text-dark-emphasis font-monospace">@doc.SyncStatus</span>
                                    }
                                </td>
                                <td class="pe-4 text-end text-nowrap">
                                    <div class="d-inline-flex align-items-center gap-1">
                                        @if (!string.IsNullOrWhiteSpace(doc.SerializedErrors))
                                        {
                                            <button type="button" class="btn btn-outline-warning btn-sm border-0 d-inline-flex align-items-center gap-1" @onclick="() => OpenEditModal(doc)" title="Resolve Errors">
                                                <span class="bi bi-exclamation-circle-fill text-danger"></span>
                                                <span>Fix</span>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-outline-secondary btn-sm border-0" @onclick="() => OpenEditModal(doc)" title="Edit">
                                                <span class="bi bi-pencil-square"></span>
                                            </button>
                                        }
                                        <a class="btn btn-outline-secondary btn-sm border-0" href="admin/documents/@doc.Id/document-versions" title="View Versions">
                                            <span class="bi bi-git"></span>
                                        </a>
                                        <button type="button" class="btn btn-outline-danger btn-sm border-0" @onclick="() => PromptDelete(doc)" title="Delete">
                                            <span class="bi bi-trash3"></span>
                                        </button>
                                    </div>
                                </td>
                            </tr>

                            @* Inline background error trace display tray *@
                            @if (!string.IsNullOrWhiteSpace(doc.SerializedErrors))
                            {
                                var errorMap = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string[]>>(doc.SerializedErrors);
                                if (errorMap is not null && errorMap.Count > 0)
                                {
                                    <tr class="table-danger">
                                        <td colspan="6" class="ps-5 pe-4 py-2 text-danger border-bottom text-wrap">
                                            <div class="card card-body bg-white border-danger shadow-sm py-2 mb-1">
                                                <div class="fw-bold text-uppercase small text-secondary mb-1">
                                                    <span class="bi bi-bug-fill me-1"></span> Server Rejection Reasons
                                                </div>
                                                <ul class="list-unstyled mb-0 small">
                                                    @foreach (var error in errorMap)
                                                    {
                                                        @foreach (var msg in error.Value)
                                                        {
                                                            <li class="d-flex align-items-start gap-1 text-danger">
                                                                <span class="bi bi-dot"></span>
                                                                <span><strong>@error.Key:</strong> @msg</span>
                                                            </li>
                                                        }
                                                    }
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <Pagination @bind-PageNumber="_filter.PageNumber"
                PageSize="DocumentFilterModel.PageSize"
                TotalCount="_totalCount"
                OnPageChanged="ApplyFilter" />
</div>

@if (_showUploadModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0, 0, 0, 0.5);" role="dialog">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content border-0 shadow-lg">
                <EditForm EditContext="@_editContext" OnValidSubmit="Save">
                    <DataAnnotationsValidator />

                    @if (_editContext!.GetValidationMessages(new FieldIdentifier(_inputModel, string.Empty)).Any())
                    {
                        <div class="alert alert-danger d-flex align-items-start gap-2 shadow-sm border-0 mb-4 animate-fade-in" role="alert">
                            <span class="bi bi-exclamation-triangle-fill fs-5 flex-shrink-0 mt-0.5" aria-hidden="true"></span>

                            <div class="flex-grow-1">
                                <h6 class="alert-heading fw-bold mb-1">Concurrency Conflict detected:</h6>
                                <ul class="mb-0 ps-0 list-unstyled small text-danger">
                                    @foreach (var message in _editContext.GetValidationMessages(new FieldIdentifier(_inputModel, string.Empty)))
                                    {
                                        <li>@message</li>
                                    }
                                </ul>
                            </div>
                        </div>
                    }

                    <div class="modal-header bg-light">
                        <h5 class="modal-title fw-bold text-dark">
                            <span class="bi @(_documentEditedId.HasValue ? "bi-pencil-square" : "bi-cloud-upload-fill") me-2"></span>
                            @(_documentEditedId.HasValue ? "Edit" : "Create")
                        </h5>
                        <button type="button" class="btn-close" @onclick="CloseUploadModal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body py-4">
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-secondary text-uppercase">Name</label>
                            <InputText class="form-control" placeholder="e.g., Q4 Financial Framework Schema" @bind-Value="_inputModel.Name" />
                            <ValidationMessage For="() => _inputModel.Name" class="text-danger small mt-1 d-block fw-semibold" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-secondary text-uppercase">Category</label>
                            <InputSelect class="form-select" @bind-Value="_inputModel.DocumentCategoryId">
                                <option value="">Select a category...</option>
                                @foreach (var cat in _categories)
                                {
                                    <option value="@cat.Id.ToString()">@cat.Name</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => _inputModel.DocumentCategoryId" class="text-danger small mt-1 d-block fw-semibold" />
                        </div>

                        @* Binary Stream Selector: Only displays for Create *@
                        @if (!_documentEditedId.HasValue)
                        {
                            <div class="mb-0">
                                <label class="form-label small fw-bold text-secondary text-uppercase">
                                    Select Document File (PDF, DOCX up to @(Web.Client.Extensions.BrowserFile.MaxMB)MB)
                                </label>
                                <InputFile class="form-control" OnChange="OnInputFileSelected" />
                                @if (!string.IsNullOrWhiteSpace(_fileValidationError))
                                {
                                    <div class="text-danger small mt-2 fw-semibold">
                                        <span class="bi bi-x-circle-fill"></span> @_fileValidationError
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="modal-footer bg-light border-0">
                        <button type="button" class="btn btn-outline-secondary fw-semibold px-4" @onclick="CloseUploadModal">Cancel</button>
                        <button type="submit" class="btn btn-primary fw-semibold px-4"
                                disabled="@(!_documentEditedId.HasValue && (_selectedBrowserFile is null || !string.IsNullOrWhiteSpace(_fileValidationError)))">
                            <span class="bi bi-check-circle-fill me-1"></span> Save
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (_showDeleteModal && _docToDelete is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-danger-subtle text-danger-emphasis">
                    <h5 class="modal-title fw-bold d-flex align-items-center gap-2">
                        <span class="bi bi-exclamation-triangle-fill"></span> Delete document
                    </h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete" aria-label="Close"></button>
                </div>

                <div class="modal-body py-4">
                    @if (!string.IsNullOrWhiteSpace(_deleteErrorMessage))
                    {
                        <div class="alert alert-danger d-flex align-items-start gap-2 shadow-sm border-0 mb-4 animate-fade-in" role="alert">
                            <span class="bi bi-exclamation-triangle-fill fs-5 flex-shrink-0 mt-0.5" aria-hidden="true"></span>
                            <div>
                                <h6 class="alert-heading fw-bold mb-1">Concurrency Conflict</h6>
                                <p class="mb-0 small">@_deleteErrorMessage</p>
                            </div>
                        </div>
                    }

                    <p class="mb-2">Are you sure you want to delete this document?</p>
                    <div class="p-3 bg-light rounded border font-monospace small text-truncate text-dark fw-bold">
                        @_docToDelete.Name
                    </div>
                    <p class="text-danger small mt-3 mb-0 fw-semibold">
                        <span class="bi bi-info-circle-fill"></span> This will flag the document and its versions for background cleanup.
                    </p>
                </div>

                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-outline-secondary fw-semibold px-4" @onclick="CancelDelete">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-danger fw-semibold px-4 d-flex align-items-center gap-2"
                            @onclick="ConfirmDelete"
                            disabled="@(!string.IsNullOrWhiteSpace(_deleteErrorMessage))">
                        <span class="bi bi-trash3-fill"></span> Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private static readonly SyncStatus[] VisibleSyncStatuses =
        [.. Enum.GetValues<SyncStatus>().Where(s => s != SyncStatus.PendingDelete)];

    private List<Document> _documents = [];
    private List<DocumentCategory> _categories = [];
    private Dictionary<Guid, string> _latestVersionMap = new();
    private DocumentFilterModel _filter = new();
    private DocumentModel _inputModel = new();
    private IBrowserFile? _selectedBrowserFile;
    private string? _fileValidationError;

    private int _totalCount = 0;

    private bool _showUploadModal;
    private Guid? _documentEditedId;

    private bool _showDeleteModal;
    private Document? _docToDelete;
    private string? _deleteErrorMessage;

    private CancellationTokenSource? _debounceCts;

    private EditContext? _editContext;
    private ValidationMessageStore? _messageStore;

    public void Dispose()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();

        SyncState.OnSyncCompleted -= HandleSyncCompleted;
        if (_editContext is not null)
        {
            _editContext.OnFieldChanged -= HandleFieldChanged;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (OperatingSystem.IsBrowser())
        {
            await HydrateFilterDropdowns();
            await ApplyFilter();
            SyncState.OnSyncCompleted += HandleSyncCompleted;
        }
    }

    private void CancelDelete()
    {
        _showDeleteModal = false;
        _docToDelete = null;
        _deleteErrorMessage = null;
    }

    private async Task ConfirmDelete()
    {
        if (_docToDelete is null) return;

        var now = TimeProvider.GetUtcNow().DateTime;
        using var context = await DbContextFactory.CreateDbContextAsync();
        var doc = await context.Documents.FindAsync(_docToDelete.Id);

        if (doc is null
            || doc.IsDeleted
            || doc.ConcurrencyStamp != _docToDelete.ConcurrencyStamp
            || doc.LocalConcurrencyStamp != _docToDelete.LocalConcurrencyStamp)
        {
            _deleteErrorMessage = Web.Client.Constants.ConcurrencyErrorMessage;
            StateHasChanged();
            return;
        }

        // Ensure OriginalValue is the pre-flight stamp
        var entry = context.Entry(doc);
        entry.Property(nameof(ISyncableEntity.ConcurrencyStamp)).OriginalValue = _docToDelete.ConcurrencyStamp;
        entry.Property(nameof(ISyncableEntity.LocalConcurrencyStamp)).OriginalValue = _docToDelete.LocalConcurrencyStamp;

        var versions = await context.DocumentVersions
            .Include(dv => dv.StoredFile)
            .Where(v => v.DocumentId == doc.Id)
            .ToListAsync();

        if (doc.SyncStatus == SyncStatus.PendingInsert)
        {
            // Never existed on the server: remove local blobs, versions, and document
            foreach (var version in versions)
            {
                if (version.StoredFile is not null)
                {
                    context.StoredFiles.Remove(version.StoredFile);
                }
            }

            context.DocumentVersions.RemoveRange(versions);
            context.Documents.Remove(doc);
        }
        else
        {
            doc.IsDeleted = true;
            doc.SyncStatus = SyncStatus.PendingDelete;
            doc.UpdatedAt = now;
            doc.SerializedErrors = null;
            doc.LocalConcurrencyStamp = Guid.NewGuid().ToString();

            foreach (var version in versions)
            {
                if (version.StoredFile is not null)
                {
                    context.StoredFiles.Remove(version.StoredFile);
                }

                if (version.SyncStatus == SyncStatus.PendingInsert)
                {
                    // Version was created offline and never synced: remove locally
                    context.DocumentVersions.Remove(version);
                }
                else if (!version.IsDeleted)
                {
                    // Ensure OriginalValue is the pre-flight stamp
                    var vEntry = context.Entry(version);
                    vEntry.Property(nameof(ISyncableEntity.ConcurrencyStamp)).OriginalValue = version.ConcurrencyStamp;
                    vEntry.Property(nameof(ISyncableEntity.LocalConcurrencyStamp)).OriginalValue = version.LocalConcurrencyStamp;

                    version.IsDeleted = true;
                    version.SyncStatus = SyncStatus.PendingDelete;
                    version.UpdatedAt = now;
                    version.SerializedErrors = null;
                    // Rotate to a new stamp
                    version.LocalConcurrencyStamp = Guid.NewGuid().ToString();
                }
            }
        }

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            _deleteErrorMessage = Web.Client.Constants.ConcurrencyErrorMessage;
            StateHasChanged();
            return;
        }

        _showDeleteModal = false;
        _docToDelete = null;
        _deleteErrorMessage = null;
        _filter.Reset();
        await ApplyFilter();
    }

    // Intercepts edits to clear target field error messages instantly
    private void HandleFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        if (_messageStore is null || _editContext is null) return;
        _messageStore.Clear(e.FieldIdentifier);
        _editContext.NotifyValidationStateChanged();
    }

    private async Task HandleSyncCompleted()
    {
        _filter.Reset();
        await ApplyFilter();

        await InvokeAsync(StateHasChanged);
    }

    private async Task HydrateFilterDropdowns()
    {
        using var context = await DbContextFactory.CreateDbContextAsync();
        _categories = await context.DocumentCategories
        .Where(c => !c.IsDeleted)
        .OrderBy(c => c.Name).ToListAsync();
    }

    private void OnInputFileSelected(InputFileChangeEventArgs e)
    {
        _selectedBrowserFile = e.File;
        _fileValidationError = _selectedBrowserFile.Validate();
    }

    private async Task OnSearchInputDebounced(ChangeEventArgs e)
    {
        _filter.SearchTerm = e.Value?.ToString() ?? string.Empty;
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        try
        {
            await Task.Delay(300, token);
            if (!token.IsCancellationRequested) await ResetPage();
        }
        catch (TaskCanceledException) { }
    }

    private void OpenCreateModal()
    {
        _documentEditedId = null;
        _inputModel = new DocumentModel();
        _selectedBrowserFile = null;
        _fileValidationError = null;

        _editContext = new EditContext(_inputModel);
        _messageStore = new ValidationMessageStore(_editContext);
        _editContext.OnFieldChanged += HandleFieldChanged;

        _showUploadModal = true;
    }

    private void OpenEditModal(Document doc)
    {
        _documentEditedId = doc.Id;
        _inputModel = new DocumentModel
        {
            Name = doc.Name,
            DocumentCategoryId = doc.DocumentCategoryId.ToString(),
            ConcurrencyStamp = doc.ConcurrencyStamp,
            LocalConcurrencyStamp = doc.LocalConcurrencyStamp
        };

        _selectedBrowserFile = null;
        _fileValidationError = null;

        _editContext = new EditContext(_inputModel);
        _messageStore = new ValidationMessageStore(_editContext);
        _editContext.OnFieldChanged += HandleFieldChanged;

        if (!string.IsNullOrWhiteSpace(doc.SerializedErrors))
        {
            var serverErrors = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string[]>>(doc.SerializedErrors);
            if (serverErrors is not null)
            {
                foreach (var err in serverErrors)
                {
                    var fieldId = new FieldIdentifier(_inputModel, err.Key);
                    foreach (var msg in err.Value)
                    {
                        _messageStore.Add(fieldId, msg);
                    }
                }
                _editContext.NotifyValidationStateChanged();
            }
        }

        _showUploadModal = true;
    }

    private void PromptDelete(Document doc)
    {
        _docToDelete = doc;
        _showDeleteModal = true;
    }

    private async Task Save()
    {
        if (_editContext is null || !_editContext.Validate()) return;

        var trimmedName = _inputModel.Name.Trim();

        using var context = await DbContextFactory.CreateDbContextAsync();

        var nameExists = await context.Documents
            .AnyAsync(d => d.Name == trimmedName
                        && !d.IsDeleted
                        && d.Id != _documentEditedId);
        if (nameExists)
        {
            var fieldIdentifier = new FieldIdentifier(_inputModel, nameof(_inputModel.Name));
            _messageStore!.Clear(fieldIdentifier);
            _messageStore!.Add(fieldIdentifier, "A document with this name already exists.");
            _editContext.NotifyValidationStateChanged();
            return;
        }

        var now = TimeProvider.GetUtcNow().DateTime;

        if (_documentEditedId.HasValue)
        {
            var existingDoc = await context.Documents.FindAsync(_documentEditedId.Value);

            if (existingDoc is null
                || existingDoc.IsDeleted
                || existingDoc.ConcurrencyStamp != _inputModel.ConcurrencyStamp
                || existingDoc.LocalConcurrencyStamp != _inputModel.LocalConcurrencyStamp)
            {
                ShowConcurrencyError();
                return;
            }

            // Ensure OriginalValue is the pre-flight stamp and rotate to a new stamp
            var entry = context.Entry(existingDoc);
            entry.Property(nameof(ISyncableEntity.ConcurrencyStamp)).OriginalValue = _inputModel.ConcurrencyStamp;
            entry.Property(nameof(ISyncableEntity.LocalConcurrencyStamp)).OriginalValue = _inputModel.LocalConcurrencyStamp;
            existingDoc.LocalConcurrencyStamp = Guid.NewGuid().ToString();

            existingDoc.Name = trimmedName;
            existingDoc.DocumentCategoryId = Guid.Parse(_inputModel.DocumentCategoryId);
            existingDoc.UpdatedAt = now;
            existingDoc.SerializedErrors = null;

            // Keep PendingInsert if it hasn't been created on the server yet; otherwise mark PendingUpdate
            if (existingDoc.SyncStatus != SyncStatus.PendingInsert)
            {
                existingDoc.SyncStatus = SyncStatus.PendingUpdate;
            }

            try
            {
                await context.SaveChangesAsync();
            }
            catch (DbUpdateConcurrencyException)
            {
                ShowConcurrencyError();
                return;
            }
        }
        else
        {
            // Create
            if (_selectedBrowserFile is null || !string.IsNullOrWhiteSpace(_fileValidationError)) return;

            var documentId = Guid.NewGuid();
            var (version, error) = await _selectedBrowserFile.ComputeAndCreateVersion(
                context.DocumentVersions,
                documentId);

            if (!string.IsNullOrWhiteSpace(error) || version is null)
            {
                _fileValidationError = error;
                return;
            }

            version.CreatedAt = now;
            version.UpdatedAt = now;
            version.LocalConcurrencyStamp = Guid.NewGuid().ToString();

            var document = new Document
            {
                Id = documentId,
                Name = trimmedName,
                DocumentCategoryId = Guid.Parse(_inputModel.DocumentCategoryId),
                CreatedAt = now,
                UpdatedAt = now,
                IsDeleted = false,
                LocalConcurrencyStamp = Guid.NewGuid().ToString(),
                SyncStatus = SyncStatus.PendingInsert
            };

            context.Documents.Add(document);
            context.DocumentVersions.Add(version);
            await context.SaveChangesAsync();
        }

        CloseUploadModal();
        _filter.Reset();
        await ApplyFilter();
    }

    private async Task ResetPage()
    {
        _filter.PageNumber = 1;
        await ApplyFilter();
    }

    private void ShowConcurrencyError()
    {
        var modelIdentifier = new FieldIdentifier(_inputModel, string.Empty);
        _messageStore!.Clear(modelIdentifier);
        _messageStore!.Add(modelIdentifier, Web.Client.Constants.ConcurrencyErrorMessage);
        _editContext!.NotifyValidationStateChanged();
    }

    private async Task ToggleSortDirection()
    {
        _filter.SortDescending = !_filter.SortDescending;
        await ApplyFilter();
    }

    private async Task ApplyFilter()
    {
        using var context = await DbContextFactory.CreateDbContextAsync();

        IQueryable<Document> query = context.Documents
            .Include(d => d.DocumentCategory)
            .Where(d => !d.IsDeleted);

        if (!string.IsNullOrWhiteSpace(_filter.SearchTerm))
        {
            var term = $"%{_filter.SearchTerm.Trim()}%";
            query = query.Where(d => EF.Functions.Like(d.Name, term));
        }

        if (_filter.CategoryId.HasValue) query = query.Where(d => d.DocumentCategoryId == _filter.CategoryId.Value);
        if (_filter.SyncStatus.HasValue) query = query.Where(d => d.SyncStatus == _filter.SyncStatus.Value);

        query = _filter.SortDescending ? query.OrderByDescending(d => d.CreatedAt) : query.OrderBy(d => d.CreatedAt);

        _totalCount = await query.CountAsync();
        _documents = await query
            .Skip((_filter.PageNumber - 1) * DocumentFilterModel.PageSize)
            .Take(DocumentFilterModel.PageSize)
            .ToListAsync();

        // Cache version hash descriptors map mapping profiles cleanly
        var docIds = _documents
            .Select(d => d.Id)
            .ToList();

        _latestVersionMap = await context.DocumentVersions
            .Where(v => docIds.Contains(v.DocumentId) && !v.IsDeleted)
            .GroupBy(v => v.DocumentId)
            .ToDictionaryAsync(
                g => g.Key,
                g => g.OrderByDescending(v => v.CreatedAt).Select(v => v.ContentHash).FirstOrDefault() ?? string.Empty);

        StateHasChanged();
    }

    private void CloseUploadModal()
    {
        if (_editContext is not null)
        {
            _editContext.OnFieldChanged -= HandleFieldChanged;
        }

        _showUploadModal = false;
        _documentEditedId = null;
        _fileValidationError = null;
        _selectedBrowserFile = null;
        _editContext = null;
        _messageStore = null;
    }
}
