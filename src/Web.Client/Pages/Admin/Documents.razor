@page "/admin/documents"
@rendermode InteractiveAuto
@attribute [Authorize(Roles = Constants.AdminRoleName)]
@layout MainLayout

@using System.Security.Cryptography
@using Domain.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Web.Client.Components
@using Web.Client.Data
@using Web.Client.Extensions
@using Web.Client.Models

@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject ILogger<Documents> Logger
@implements IDisposable

<CustomPageTitle Value="Documents" />

<div class="p-4 animate-fade-in">
    <PageHeader Title="Document Management" Subtitle="Maintain enterprise files, index schemas, and document binaries" IconClass="bi-file-earmark-text-fill">
        <ActionContent>
            <button class="btn btn-primary d-flex align-items-center gap-2 shadow-sm fw-semibold" @onclick="OpenCreateModal">
                <span class="bi bi-cloud-upload-fill"></span> Upload Document
            </button>
        </ActionContent>
    </PageHeader>

    <!-- Search, Filter Panel Panel Controls -->
    <div class="card border-0 shadow-sm p-3 mb-4 bg-light">
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-bold text-secondary text-uppercase">Search</label>
                <input type="text" class="form-control" placeholder="Search documents by name..." value="@_filter.SearchTerm" @oninput="OnSearchInputDebounced" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-secondary text-uppercase">Category</label>
                <select class="form-select" @bind="_filter.CategoryIdFilter" @bind:after="ResetPage">
                    <option value="">Categories</option>
                    @foreach (var cat in _categories)
                    {
                        <option value="@cat.Id">@cat.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-secondary text-uppercase">Sync Status</label>
                <select class="form-select" @bind="_filter.SyncStatusFilter" @bind:after="ResetPage">
                    <option value="">Sync States</option>
                    @foreach (var status in Enum.GetValues<SyncStatus>())
                    {
                        <option value="@status">@status.ToString()</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-outline-secondary w-100 fw-semibold" @onclick="ToggleSortDirection">
                    <span class="bi @(_filter.SortDescending ? "bi-sort-down-alt" : "bi-sort-up")"></span> Direction
                </button>
            </div>
        </div>
    </div>

    <!-- Grid -->
    <div class="card border-0 shadow-sm overflow-hidden mb-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small text-uppercase">
                    <tr>
                        <th class="ps-4">Name</th>
                        <th>Category</th>
                        <th>Latest Version Hash</th>
                        <th>Created At</th>
                        <th>Sync State</th>
                        <th class="pe-4 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @if (_documents.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center p-5 text-muted">No documents.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var doc in _documents)
                        {
                            <tr class="animate-fade-in @(!string.IsNullOrWhiteSpace(doc.SerializedErrors) ? "table-danger-light border-start border-danger border-3" : "")">
                                <td class="ps-4 fw-bold text-dark">
                                    @doc.Name
                                    @if (!string.IsNullOrWhiteSpace(doc.SerializedErrors))
                                    {
                                        <span class="badge bg-danger ms-1 text-white animate-pulse" title="Sync Rejected">Error</span>
                                    }
                                </td>
                                <td class="text-secondary">@(doc.DocumentCategory?.Name ?? "Unassigned")</td>
                                <td>
                                    <span class="badge bg-light text-secondary border font-monospace px-2">
                                        @(_latestVersionMap.TryGetValue(doc.Id, out var hash) ? hash[..8] + "..." : "No versions")
                                    </span>
                                </td>
                                <td>@doc.CreatedAt.ToLocalTime().ToString("g")</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(doc.SerializedErrors))
                                    {
                                        <span class="badge bg-danger text-white border-0">Sync Error</span>
                                    }
                                    else if (doc.SyncStatus == SyncStatus.PendingInsert)
                                    {
                                        <span class="badge bg-info text-dark border"><span class="spinner-border spinner-border-sm me-1" style="width:0.7rem; height:0.7rem;"></span> Queued</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-dark-subtle text-dark-emphasis">@doc.SyncStatus</span>
                                    }
                                </td>
                                <td class="pe-4 text-end">
                                    @if (!string.IsNullOrWhiteSpace(doc.SerializedErrors))
                                    {
                                        <button class="btn btn-outline-warning btn-sm border-0 me-1" @onclick="() => OpenEditModal(doc)" title="Resolve Errors">
                                            <span class="bi bi-exclamation-circle-fill text-danger"></span> Fix
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-outline-secondary btn-sm border-0 me-1" @onclick="() => OpenEditModal(doc)" title="Edit">
                                            <span class="bi bi-pencil-square"></span>
                                        </button>
                                    }
                                    <a class="btn btn-outline-secondary btn-sm border-0 me-1" href="admin/documents/@doc.Id/document-versions" title="View Versions">
                                        <span class="bi bi-git"></span>
                                    </a>
                                    <button class="btn btn-outline-danger btn-sm border-0" @onclick="() => PromptDelete(doc)" title="Delete">
                                        <span class="bi bi-trash3"></span>
                                    </button>
                                </td>
                            </tr>

                            @* Inline background error trace display tray *@
                            @if (!string.IsNullOrWhiteSpace(doc.SerializedErrors))
                            {
                                var errorMap = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string[]>>(doc.SerializedErrors);
                                if (errorMap is not null && errorMap.Count > 0)
                                {
                                    <tr class="table-danger-light">
                                        <td colspan="6" class="ps-5 pe-4 py-2 font-sans-serif text-danger bg-opacity-10 border-bottom">
                                            <div class="card card-body bg-white border-danger shadow-xs py-2 mb-1">
                                                <div class="fw-bold text-uppercase small text-secondary mb-1"><span class="bi bi-bug-fill me-1"></span> Server Rejection Reasons</div>
                                                <ul class="list-unstyled mb-0 small">
                                                    @foreach (var error in errorMap)
                                                    {
                                                        @foreach (var msg in error.Value)
                                                        {
                                                            <li class="d-flex align-items-start gap-1 text-danger">
                                                                <span class="bi bi-dot mt-0.5"></span>
                                                                <span><strong>@error.Key:</strong> @msg</span>
                                                            </li>
                                                        }
                                                    }
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <Pagination @bind-PageNumber="_filter.PageNumber"
                PageSize="_filter.PageSize"
                TotalCount="_totalCount"
                OnPageChanged="ApplyFilter" />
</div>

<!-- Upload Document + Version Modal Box -->
@if (_showUploadModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0, 0, 0, 0.5);" role="dialog">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content border-0 shadow-lg">
                <EditForm EditContext="@_editContext" OnValidSubmit="Save">
                    <DataAnnotationsValidator />
                    
                    <div class="modal-header bg-light">
                        <h5 class="modal-title fw-bold text-dark">
                            <span class="bi @(_documentEditedId.HasValue ? "bi-pencil-square" : "bi-cloud-upload-fill") me-2"></span>
                            @(_documentEditedId.HasValue ? "Edit" : "Create")
                        </h5>
                        <button type="button" class="btn-close" @onclick="CloseCreateModal" aria-label="Close"></button>
                    </div>
                    
                    <div class="modal-body py-4">
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-secondary text-uppercase">Name</label>
                            <InputText class="form-control" placeholder="e.g., Q4 Financial Framework Schema" @bind-Value="_inputModel.Name" />
                            <ValidationMessage For="() => _inputModel.Name" class="text-danger small mt-1 d-block fw-semibold" />
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-secondary text-uppercase">Category</label>
                            <InputSelect class="form-select" @bind-Value="_inputModel.DocumentCategoryId">
                                <option value="">Select a category...</option>
                                @foreach (var cat in _categories)
                                {
                                    <option value="@cat.Id.ToString()">@cat.Name</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => _inputModel.DocumentCategoryId" class="text-danger small mt-1 d-block fw-semibold" />
                        </div>
                        
                        @* Binary Stream Selector: Only displays for Create *@
                        @if (!_documentEditedId.HasValue)
                        {
                            <div class="mb-0">
                                <label class="form-label small fw-bold text-secondary text-uppercase">
                                    Select Document File (PDF, DOCX up to @(Web.Client.Extensions.BrowserFile.MaxMB)MB)
                                </label>
                                <InputFile class="form-control" OnChange="OnInputFileSelected" />
                                @if (!string.IsNullOrWhiteSpace(_fileValidationError))
                                {
                                    <div class="text-danger small mt-2 fw-semibold">
                                        <span class="bi bi-x-circle-fill"></span> @_fileValidationError
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    
                    <div class="modal-footer bg-light border-0">
                        <button type="button" class="btn btn-outline-secondary fw-semibold px-4" @onclick="CloseCreateModal">Cancel</button>
                        <button type="submit" class="btn btn-primary fw-semibold px-4" 
                                disabled="@(!_documentEditedId.HasValue && (_selectedBrowserFile is null || !string.IsNullOrWhiteSpace(_fileValidationError)))">
                            <span class="bi bi-check-circle-fill me-1"></span> Save
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation -->
@if (_showDeleteModal && _docToDelete is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-danger-subtle text-danger-emphasis">
                    <h5 class="modal-title fw-bold d-flex align-items-center gap-2">
                        <span class="bi bi-exclamation-triangle-fill"></span> Delete document
                    </h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete" aria-label="Close"></button>
                </div>

                <div class="modal-body py-4">
                    <p class="mb-2">Are you sure you want to delete this document? This will soft-delete all attached versions.</p>
                    <div class="p-3 bg-light rounded border font-monospace small text-truncate text-dark fw-bold">
                        @_docToDelete.Name
                    </div>
                    <p class="text-danger small mt-3 mb-0 fw-semibold">
                        <span class="bi bi-info-circle-fill"></span> This will flag the document for background cleanup.
                    </p>
                </div>

                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-outline-secondary fw-semibold px-4" @onclick="CancelDelete">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-danger fw-semibold px-4 d-flex align-items-center gap-2" @onclick="ConfirmDelete">
                        <span class="bi bi-trash3-fill"></span> Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
}


@code {
    private List<Document> _documents = [];
    private List<DocumentCategory> _categories = [];
    private Dictionary<Guid, string> _latestVersionMap = new();
    private DocumentFilterModel _filter = new();
    private DocumentModel _inputModel = new();
    private IBrowserFile? _selectedBrowserFile = null;
    private string? _fileValidationError = null;

    private int _totalCount = 0;
    private bool _showUploadModal = false;
    private bool _showDeleteModal = false;
    private Document? _docToDelete = null;
    private CancellationTokenSource? _debounceCts;

    private EditContext? _editContext;
    private ValidationMessageStore? _messageStore;
    private Guid? _documentEditedId = null;

    public void Dispose()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();

        if (_editContext is not null)
        {
            _editContext.OnFieldChanged -= HandleFieldChanged;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (OperatingSystem.IsBrowser())
        {
            await HydrateFilterDropdowns();
            await ApplyFilter();
        }
    }

    private void CancelDelete()
    {
        _showDeleteModal = false;
        _docToDelete = null;
    }
 
    private void CloseCreateModal()
    {
        if (_editContext is not null)
        {
            _editContext.OnFieldChanged -= HandleFieldChanged;
        }

        _showUploadModal = false;
        _documentEditedId = null;
        _fileValidationError = null;
        _selectedBrowserFile = null;
        _editContext = null;
        _messageStore = null;
    }

    private async Task ConfirmDelete()
    {
        if (_docToDelete is null) return;

        using var context = await DbContextFactory.CreateDbContextAsync();
        var now = DateTime.UtcNow;
        var doc = await context.Documents.FindAsync(_docToDelete.Id);
        if (doc is not null)
        {
            doc.IsDeleted = true;
            doc.SyncStatus = SyncStatus.PendingDelete;
            doc.UpdatedAt = now;

            var versions = await context.DocumentVersions.Where(v => v.DocumentId == doc.Id).ToListAsync();
            foreach (var v in versions)
            {
                v.IsDeleted = true;
                v.SyncStatus = SyncStatus.PendingDelete;
                v.UpdatedAt = now;
            }
            await context.SaveChangesAsync();
        }
            
        _showDeleteModal = false;    
        _docToDelete = null;
        await ApplyFilter();
    }

    // Intercepts edits to clear target field error messages instantly
    private void HandleFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        if (_messageStore is null || _editContext is null) return;
        _messageStore.Clear(e.FieldIdentifier);
        _editContext.NotifyValidationStateChanged();
    }

    private async Task HydrateFilterDropdowns()
    {
        using var context = await DbContextFactory.CreateDbContextAsync();
        _categories = await context.DocumentCategories
        .Where(c => !c.IsDeleted)
        .OrderBy(c => c.Name).ToListAsync();
    }

    private void OnInputFileSelected(InputFileChangeEventArgs e)
    {
        _selectedBrowserFile = e.File;
        _fileValidationError = _selectedBrowserFile.Validate();
    }

    private async Task OnSearchInputDebounced(ChangeEventArgs e)
    {
        _filter.SearchTerm = e.Value?.ToString() ?? string.Empty;
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        try
        {
            await Task.Delay(300, token);
            if (!token.IsCancellationRequested) await ResetPage();
        }
        catch (TaskCanceledException) { }
    }

    private void OpenCreateModal()
    {
        _documentEditedId = null;
        _inputModel = new DocumentModel();
        _selectedBrowserFile = null;
        _fileValidationError = null;

        _editContext = new EditContext(_inputModel);
        _messageStore = new ValidationMessageStore(_editContext);
        _editContext.OnFieldChanged += HandleFieldChanged;

        _showUploadModal = true;
    }

    private void OpenEditModal(Document doc)
    {
        _documentEditedId = doc.Id;
        _inputModel = new DocumentModel
        {
            Name = doc.Name,
            DocumentCategoryId = doc.DocumentCategoryId.ToString()
        };

        _selectedBrowserFile = null;
        _fileValidationError = null;

        _editContext = new EditContext(_inputModel);
        _messageStore = new ValidationMessageStore(_editContext);
        _editContext.OnFieldChanged += HandleFieldChanged;

        if (!string.IsNullOrWhiteSpace(doc.SerializedErrors))
        {
            var serverErrors = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string[]>>(doc.SerializedErrors);
            if (serverErrors is not null)
            {
                foreach (var err in serverErrors)
                {
                    var fieldId = new FieldIdentifier(_inputModel, err.Key);
                    foreach (var msg in err.Value)
                    {
                        _messageStore.Add(fieldId, msg);
                    }
                }
                _editContext.NotifyValidationStateChanged();
            }
        }

        _showUploadModal = true;
    }

    private void PromptDelete(Document doc)
    {
        _docToDelete = doc;
        _showDeleteModal = true;
    }

    private async Task ResetPage()
    {
        _filter.PageNumber = 1;
        await ApplyFilter();
    }

    private async Task Save()
    {
        if (_editContext is null || !_editContext.Validate()) return;

        using var context = await DbContextFactory.CreateDbContextAsync();
        var now = DateTime.UtcNow;

        if (_documentEditedId.HasValue)
        {
            // Edit
            var existingDoc = await context.Documents.FindAsync(_documentEditedId.Value);
            if (existingDoc is not null)
            {
                existingDoc.Name = _inputModel.Name.Trim();
                existingDoc.DocumentCategoryId = Guid.Parse(_inputModel.DocumentCategoryId);
                existingDoc.UpdatedAt = now;
                
                // Clear rejection parameters to re-queue back into execution synchronization loops
                existingDoc.SerializedErrors = null;
                existingDoc.SyncStatus = SyncStatus.PendingUpdate;

                context.Documents.Update(existingDoc);
            }
        }
        else
        {
            // Create
            if (_selectedBrowserFile is null || !string.IsNullOrWhiteSpace(_fileValidationError)) return;

            var documentId = Guid.NewGuid();
            var (version, error) = await _selectedBrowserFile.ComputeAndCreateVersion(
                context.DocumentVersions,
                documentId);

            if (!string.IsNullOrWhiteSpace(error) || version is null)
            {
                _fileValidationError = error;
                return;
            }

            var document = new Document
            {
                Id = documentId,
                Name = _inputModel.Name.Trim(),
                DocumentCategoryId = Guid.Parse(_inputModel.DocumentCategoryId),
                CreatedAt = version.CreatedAt,
                UpdatedAt = version.UpdatedAt,
                IsDeleted = false,
                SyncStatus = SyncStatus.PendingInsert
            };

            context.Documents.Add(document);
            context.DocumentVersions.Add(version);
            _filter.Reset();
        }

        await context.SaveChangesAsync();
        CloseCreateModal();
        await ApplyFilter();
    }

    private async Task ToggleSortDirection()
    {
        _filter.SortDescending = !_filter.SortDescending;
        await ApplyFilter();
    }

    private async Task ApplyFilter()
    {
        using var context = await DbContextFactory.CreateDbContextAsync();

        IQueryable<Document> query = context.Documents
        .Include(d => d.DocumentCategory)
        .Where(d => !d.IsDeleted);

        if (!string.IsNullOrWhiteSpace(_filter.SearchTerm))
        {
            var term = $"%{_filter.SearchTerm.Trim()}%";
            query = query.Where(d => EF.Functions.Like(d.Name, term));
        }

        if (_filter.CategoryIdFilter.HasValue) query = query.Where(d => d.DocumentCategoryId == _filter.CategoryIdFilter.Value);
        if (_filter.SyncStatusFilter.HasValue) query = query.Where(d => d.SyncStatus == _filter.SyncStatusFilter.Value);

        _totalCount = await query.CountAsync();
        query = _filter.SortDescending ? 
        query.OrderByDescending(d => d.CreatedAt) : query.OrderBy(d => d.CreatedAt);

        _documents = await query.Skip((_filter.PageNumber - 1) * _filter.PageSize)
        .Take(_filter.PageSize)
        .ToListAsync();

        // Cache version hash descriptors map mapping profiles cleanly
        var docIds = _documents.Select(d => d.Id)
        .ToList();

        _latestVersionMap = await context.DocumentVersions
        .Where(v => docIds.Contains(v.DocumentId) && !v.IsDeleted)
        .GroupBy(v => v.DocumentId)
        .ToDictionaryAsync(
            g => g.Key,
            g => g.OrderByDescending(v => v.CreatedAt).Select(v => v.ContentHash).FirstOrDefault() ?? string.Empty
        );

        StateHasChanged();
    }
}
