@page "/admin/documents/{DocumentId:guid}/document-versions"
@rendermode InteractiveAuto
@attribute [Authorize(Roles = Domain.Shared.Constants.AdminRoleName)]
@layout MainLayout

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using SqliteWasmHelper
@using Web.Client.Components
@using Web.Client.Data
@using Web.Client.Extensions
@using Web.Client.Services

@inject ISqliteWasmDbContextFactory<ApplicationDbContext> DbContextFactory
@inject ILogger<DocumentVersions> Logger
@inject SyncStateProvider SyncState
@inject TimeProvider TimeProvider

<CustomPageTitle Value="Document Versions" />

<div class="p-4 animate-fade-in">
    <PageHeader Title="Document Versions" Subtitle="@($"Document Id: {_documentName} (#{DocumentId})")" IconClass="bi bi-file-earmark-text">
        <ActionContent>
            <a href="/admin/documents" class="btn btn-sm btn-outline-secondary mb-2 fw-semibold">
                <span class="bi bi-arrow-left"></span> Documents
            </a>
            <button class="btn btn-primary d-flex align-items-center gap-2 shadow-sm fw-semibold" @onclick="OpenUploadModal">
                <span class="bi bi-plus-circle"></span> Create
            </button>
        </ActionContent>
    </PageHeader>

    @* Global Alert Banner for Blocked Sync Retries *@
    @if (_versions.Any(v => !string.IsNullOrWhiteSpace(v.SerializedErrors)))
    {
        <div class="alert alert-warning border-0 shadow-sm d-flex align-items-center gap-3 mb-4" role="alert">
            <span class="bi bi-exclamation-triangle-fill fs-4 text-warning"></span>
            <div>
                <strong class="d-block">Offline Synchronisation Suspended</strong>
                <span class="small text-secondary">One or versions have server validation rejections. Please fix the properties outlined below to resume sync.</span>
            </div>
        </div>
    }

    <div class="card border-0 shadow-sm overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-dark text-uppercase small" style="font-size:0.75rem;">
                    <tr>
                        <th class="ps-4">Version Commit ID</th>
                        <th>Content Hash</th>
                        <th>Remote Cloud Blob Identifier</th>
                        <th>Created At</th>
                        <th>Status</th>
                        <th class="pe-4 text-end">Actions</th>
                    </tr>
                </thead>

                <tbody class="small font-monospace">
                    @if (_versions.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center p-5 text-muted font-sans-serif">
                                <span class="bi bi-git fs-1 d-block mb-2 text-secondary opacity-50"></span>
                                No Versions
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var version in _versions)
                        {

                            <tr class="@(!string.IsNullOrWhiteSpace(version.SerializedErrors) ? "table-danger-light border-start border-danger border-3" : "")">
                                <td class="ps-4 text-secondary">#@version.Id.ToString()[..8]</td>
                                <td class="fw-bold text-dark text-truncate" style="max-width: 200px;" title="@version.ContentHash">@version.ContentHash</td>
                                <td class="text-primary text-truncate" style="max-width:140px;">@(version.StoredFile?.Type ?? string.Empty)</td>
                                <td class="font-sans-serif">@version.CreatedAt.ToLocalTime().ToString("G")</td>
                                <td class="font-sans-serif">
                                    @if (!string.IsNullOrWhiteSpace(version.SerializedErrors))
                                    {
                                        <span class="badge bg-danger text-white border-0 shadow-sm animate-pulse" title="Validation Errors">Sync Error</span>
                                    }
                                    else if (version.SyncStatus == SyncStatus.PendingInsert)
                                    {
                                        <span class="badge bg-info text-dark border"><span class="spinner-border spinner-border-sm me-1" style="width:0.7rem; height:0.7rem;"></span> Queued</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-secondary border">@version.SyncStatus</span>
                                    }
                                </td>
                                <td class="pe-4 text-end font-sans-serif">
                                    @if (!string.IsNullOrWhiteSpace(version.SerializedErrors))
                                    {
                                        <button class="btn btn-sm btn-outline-warning fw-semibold me-1 border-0" @onclick="() => EditRejectedVersion(version)">
                                            <span class="bi bi-pencil-square"></span> Resolve
                                        </button>
                                    }
                                    <button class="btn btn-outline-danger btn-sm border-0" @onclick="() => PromptDelete(version)" title="Delete">
                                        <span class="bi bi-trash3-fill"></span> Delete
                                    </button>
                                </td>
                            </tr>

                            @* Inline error details tray display beneath the rejected row element *@
                            @if (!string.IsNullOrWhiteSpace(version.SerializedErrors))
                            {
                                var errorMap = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string[]>>(version.SerializedErrors);
                                if (errorMap is not null && errorMap.Count > 0)
                                {
                                    <tr class="table-danger-light">
                                        <td colspan="6" class="ps-5 pe-4 py-2 font-sans-serif text-danger bg-opacity-10 border-bottom">
                                            <div class="card card-body bg-white border-danger shadow-xs py-2 mb-2">
                                                <div class="fw-bold text-uppercase small text-secondary mb-1"><span class="bi bi-bug-fill me-1"></span> Server Validation Errors</div>
                                                <ul class="list-unstyled mb-0 small">
                                                    @foreach (var error in errorMap)
                                                    {
                                                        @foreach (var msg in error.Value)
                                                        {
                                                            <li class="d-flex align-items-start gap-1 text-danger">
                                                                <span class="bi bi-dot mt-0.5"></span>
                                                                <span><strong>@error.Key:</strong> @msg</span>
                                                            </li>
                                                        }
                                                    }
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (_showUploadModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold text-dark">
                        <span class="bi @(_versionToEdit is null ? "bi-plus-circle" : "bi-arrow-repeat") me-2"></span>
                        @(_versionToEdit is null ? "Upload" : "Re-upload")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseUploadModal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-4">
                    @if (!string.IsNullOrWhiteSpace(_editErrorMessage))
                    {
                        <div class="alert alert-danger d-flex align-items-start gap-2 shadow-sm border-0 mb-4 animate-fade-in" role="alert">
                            <span class="bi bi-exclamation-triangle-fill fs-5 flex-shrink-0 mt-0.5" aria-hidden="true"></span>
                            <div>
                                <h6 class="alert-heading fw-bold mb-1">Concurrency Conflict</h6>
                                <p class="mb-0 small">@_editErrorMessage</p>
                            </div>
                        </div>
                    }

                    <p class="small text-secondary mb-3">
                        Select a file to attach. Only PDF and DOCX formats up to @(Web.Client.Extensions.BrowserFile.MaxMB)MB are supported.
                    </p>

                    <div class="mb-0">
                        <label class="form-label small fw-bold text-secondary text-uppercase">
                            Select File
                        </label>
                        <InputFile class="form-control" OnChange="OnInputFileSelected" />

                        @if (!string.IsNullOrWhiteSpace(_fileValidationError))
                        {
                            <div class="text-danger small mt-2 fw-semibold">
                                <span class="bi bi-x-circle-fill"></span> @_fileValidationError
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-outline-secondary fw-semibold px-4" @onclick="CloseUploadModal">Cancel</button>
                    @* Disable the submission path if an active background sync collision hits *@
                    <button type="button" class="btn btn-primary fw-semibold px-4" @onclick="Save"
                            disabled="@(_selectedBrowserFile is null || !string.IsNullOrWhiteSpace(_fileValidationError) || !string.IsNullOrWhiteSpace(_editErrorMessage))">
                        <span class="bi @(_versionToEdit is null ? "bi-cloud-arrow-up-fill" : "bi-check-circle-fill") me-1"></span>
                        @(_versionToEdit is null ? "Save" : "Apply & Re-queue")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showDeleteModal && _versionToDelete is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-danger-subtle text-danger-emphasis">
                    <h5 class="modal-title fw-bold d-flex align-items-center gap-2">
                        <span class="bi bi-exclamation-triangle-fill"></span> Delete version
                    </h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete" aria-label="Close"></button>
                </div>

                <div class="modal-body py-4">
                    @if (!string.IsNullOrWhiteSpace(_deleteErrorMessage))
                    {
                        <div class="alert alert-danger d-flex align-items-start gap-2 shadow-sm border-0 mb-4 animate-fade-in" role="alert">
                            <span class="bi bi-exclamation-triangle-fill fs-5 flex-shrink-0 mt-0.5" aria-hidden="true"></span>
                            <div>
                                <h6 class="alert-heading fw-bold mb-1">Concurrency Conflict</h6>
                                <p class="mb-0 small">@_deleteErrorMessage</p>
                            </div>
                        </div>
                    }

                    <p class="mb-2">Are you sure you want to delete this version?</p>
                    <div class="p-3 bg-light rounded border font-monospace small text-truncate text-dark fw-bold">
                        #@_versionToDelete.Id.ToString()[..8]
                    </div>
                    <p class="text-danger small mt-3 mb-0 fw-semibold">
                        <span class="bi bi-info-circle-fill"></span> This will flag the version for background cleanup.
                    </p>
                </div>

                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-outline-secondary fw-semibold px-4" @onclick="CancelDelete">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-danger fw-semibold px-4 d-flex align-items-center gap-2" 
                            @onclick="ConfirmDelete"
                            disabled="@(!string.IsNullOrWhiteSpace(_deleteErrorMessage))">
                        <span class="bi bi-trash3-fill"></span> Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
}


@code {
    [Parameter] public Guid DocumentId { get; set; }

    private List<DocumentVersion> _versions = [];
    private string _documentName = "Loading...";

    private IBrowserFile? _selectedBrowserFile;
    private string? _fileValidationError;

    private bool _showUploadModal;

    private DocumentVersion? _versionToEdit;
    private string? _editErrorMessage;

    private bool _showDeleteModal;
    private DocumentVersion? _versionToDelete;
    private string? _deleteErrorMessage;

    public void Dispose()
    {
        SyncState.OnSyncCompleted -= HandleSyncCompleted;
    }

    protected override async Task OnInitializedAsync()
    {
        if (OperatingSystem.IsBrowser())
        {
            await LoadDocument();
            await LoadVersions();
            SyncState.OnSyncCompleted += HandleSyncCompleted;
        }
    }

    private void CancelDelete()
    {
        _showDeleteModal = false;
        _versionToDelete = null;
        _deleteErrorMessage = null;
    }

    private async Task ConfirmDelete()
    {
        if (_versionToDelete is null) return;

        var now = TimeProvider.GetUtcNow().DateTime;
        using var context = await DbContextFactory.CreateDbContextAsync();
        var version = await context.DocumentVersions
            .Include(dv => dv.StoredFile)
            .FirstOrDefaultAsync(v => v.Id == _versionToDelete.Id);

        if (version is not null)
        {
            version.IsDeleted = true;
            version.SyncStatus = SyncStatus.PendingDelete;
            version.UpdatedAt = now;
            version.ConcurrencyStamp = _versionToDelete.ConcurrencyStamp;
            if (version.StoredFile is not null)
            {
                context.StoredFiles.Remove(version.StoredFile);
            }

            try
            {
                 await context.SaveChangesAsync();
            }
            catch (DbUpdateConcurrencyException)
            {
                _deleteErrorMessage = Web.Client.Constants.ConcurrencyErrorMessage;
                StateHasChanged();
                return;
            }
        }

        _showDeleteModal = false;
        _versionToDelete = null;
        _deleteErrorMessage = null;
        await LoadVersions();
    }

    private void EditRejectedVersion(DocumentVersion version)
    {
        _versionToEdit = version;
        _selectedBrowserFile = null;
        _fileValidationError = null;
        _showUploadModal = true;
    }

    private async Task HandleSyncCompleted()
    {
        await LoadVersions();

        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadDocument()
    {
        using var context = await DbContextFactory.CreateDbContextAsync();
        var doc = await context.Documents.FindAsync(DocumentId);
        if (doc is not null)
        {
            _documentName = doc.Name;
        }
    }

    private void OnInputFileSelected(InputFileChangeEventArgs e)
    {
        _selectedBrowserFile = e.File;
        _fileValidationError = _selectedBrowserFile.Validate();
    }

    private void OpenUploadModal()
    {
        _versionToEdit = null;
        _selectedBrowserFile = null;
        _fileValidationError = null;
        _showUploadModal = true;
    }

    private void PromptDelete(DocumentVersion version)
    {
        _versionToDelete = version;
        _showDeleteModal = true;
    }

    private async Task Save()
    {
        if (_selectedBrowserFile is null || !string.IsNullOrWhiteSpace(_fileValidationError)) return;

        var now = TimeProvider.GetUtcNow().DateTime;
        using var context = await DbContextFactory.CreateDbContextAsync();

        var document = await context.Documents.FindAsync(DocumentId);
        if (document is null)
        {
            Logger.LogError("Document doesn't exist");
            return;
        }

        if (_versionToEdit is null)
        {
            var (newVersion, error) = await _selectedBrowserFile.ComputeAndCreateVersion(
                context.DocumentVersions,
                DocumentId);

            if (!string.IsNullOrWhiteSpace(error) || newVersion is null)
            {
                _fileValidationError = error;
                return;
            }

            newVersion.CreatedAt = now;
            newVersion.UpdatedAt = now;
            context.DocumentVersions.Add(newVersion);
            await context.SaveChangesAsync();
        }
        else
        {
            var version = await context.DocumentVersions
                .Include(v => v.StoredFile)
                .FirstOrDefaultAsync(v => v.Id == _versionToEdit.Id);
            if (version is null) return;

            var error = await _selectedBrowserFile.ComputeAndUpdateVersion(
                context.DocumentVersions,
                version);

            if (!string.IsNullOrWhiteSpace(error))
            {
                _fileValidationError = error;
                return;
            }

            version.UpdatedAt = now;
            version.ConcurrencyStamp = _versionToEdit.ConcurrencyStamp;
            try
            {
                 await context.SaveChangesAsync();
            }
            catch (DbUpdateConcurrencyException)
            {
                _editErrorMessage = Web.Client.Constants.ConcurrencyErrorMessage;
                StateHasChanged();
                return;
            }
        }
      
        CloseUploadModal();
        await LoadVersions();
    }

    private void CloseUploadModal()
    {
        _showUploadModal = false;
        _versionToEdit = null;
        _fileValidationError = null;
        _selectedBrowserFile = null;
    }

    private async Task LoadVersions()
    {
        using var context = await DbContextFactory.CreateDbContextAsync();

        _versions = await context.DocumentVersions
            .Include(v => v.StoredFile)
            .Where(v => v.DocumentId == DocumentId && !v.IsDeleted)
            .OrderByDescending(v => v.CreatedAt)
            .ToListAsync();
    }
}