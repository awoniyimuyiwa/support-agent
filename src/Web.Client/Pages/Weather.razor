@page "/weather"
@rendermode InteractiveAuto
@attribute [AllowAnonymous]
@layout MainLayout

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using SqliteWasmHelper
@using Web.Client.Components
@using Web.Client.Data

@inject ApiClient ApiClient
@inject ISqliteWasmDbContextFactory<ApplicationDbContext> DbContextFactory
@inject PersistentComponentState ApplicationState
@inject ILogger<Weather> Logger

@implements IDisposable

<CustomPageTitle Value="Weather" />

<h1>Weather</h1>
<p>This component demonstrates showing data loaded from an API, with automatic local fallback if offline.</p>

@if (_forecasts == null)
{
    <p><em>Loading data...</em></p>
}
else
{
    @if (isOfflineData)
    {
        <div class="alert alert-warning py-2 shadow-sm d-flex align-items-center gap-2 animate-fade-in" role="alert">
            <span class="bi bi-exclamation-triangle-fill"></span>
            <strong>Offline Mode:</strong> You are viewing data cached locally in your browser's SQLite database.
        </div>
    }

    <table class="table table-hover align-middle shadow-sm border rounded rounded-3 overflow-hidden">
        <thead class="table-light">
            <tr>
                <th>Date</th>
                <th aria-label="Temperature in Celsius">Temp. (°C)</th>
                <th aria-label="Temperature in Fahrenheit">Temp. (°F)</th>
                <th>Summary</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var forecast in _forecasts)
            {
                <tr>
                    <td class="fw-semibold">@forecast.Date.ToShortDateString()</td>
                    <td><span class="badge bg-danger-subtle text-danger px-2.5 py-1.5 fs-7">@forecast.TemperatureC°C</span></td>
                    <td><span class="badge bg-primary-subtle text-primary px-2.5 py-1.5 fs-7">@((32 + (int)(forecast.TemperatureC / 0.5556)))°F</span></td>
                    <td class="text-secondary font-monospace">@forecast.Summary</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private const string WeatherStateKey = "weather";

    private List<WeatherForecast>? _forecasts;
    
    private bool isOfflineData = false;
    
    private PersistingComponentStateSubscription _subscription;

    public void Dispose()
    {
        _subscription.Dispose();
    }

    /// <summary>
    /// If a component is running in InteractiveAuto mode, 
    /// OnInitializedAsync executes twice: first on the server (for pre-rendering), and then again in the browser (client-side).
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        _subscription = ApplicationState.RegisterOnPersisting(PersistData);

        if (ApplicationState.TryTakeFromJson<List<WeatherForecast>>(WeatherStateKey, out var cachedForecasts))
        {
            Logger.LogInformation("Successfully recovered pre-rendered state inside browser WebAssembly runtime context.");
            _forecasts = cachedForecasts;
        }
        else
        {
            try
            {
                var responseModels = await ApiClient.StreamWeatherForecasts();

                _forecasts = responseModels.Select(x => new WeatherForecast
                {
                    Id = x.Id,
                    Date = x.Date,
                    TemperatureC = x.TemperatureC,
                    Summary = x.Summary,
                    ConcurrencyStamp = x.ConcurrencyStamp,
                    SyncStatus = SyncStatus.Synced
                }).ToList();

                if (OperatingSystem.IsBrowser() && _forecasts.Any())
                {
                    _ = Task.Run(() => SaveToLocalDatabase(_forecasts));
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "API data stream retrieval failed.");

                if (OperatingSystem.IsBrowser())
                {
                    await LoadFromLocalDatabase();
                }
                else
                {
                    _forecasts = null;
                }
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _forecasts is null)
        {
            await LoadFromLocalDatabase();
        }
    }

    private async Task LoadFromLocalDatabase()
    {
        try
        {
            using var context = await DbContextFactory.CreateDbContextAsync();

            var localItems = await context.WeatherForecasts               
                .OrderBy(x => x.Date)                
                .ToListAsync();

            if (localItems.Any())
            {
                _forecasts = localItems;
                isOfflineData = true;
                StateHasChanged();
                Logger.LogInformation("Successfully completed layout hydration from local SQLite fallback storage.");
            }
        }
        catch (Exception ex)
        {           
            Logger.LogError(ex, "Local caching layer execution pass aborted due to an internal processing failure.");
        }
    }

    private Task PersistData()
    {
        if (_forecasts is not null)
        {
            ApplicationState.PersistAsJson(WeatherStateKey, _forecasts);
        }
        return Task.CompletedTask;
    }

    private async Task SaveToLocalDatabase(List<WeatherForecast> itemsToCache)
    {
        try
        {
            using var context = await DbContextFactory.CreateDbContextAsync();

            foreach (var item in itemsToCache)
            {
                var existing = await context.WeatherForecasts.FindAsync(item.Id);
                if (existing is null)
                {
                    context.WeatherForecasts.Add(item);
                }
                else
                {
                    existing.Date = item.Date;
                    existing.TemperatureC = item.TemperatureC;
                    existing.Summary = item.Summary;
                    existing.ConcurrencyStamp = item.ConcurrencyStamp;
                    existing.SyncStatus = item.SyncStatus;
                }
            }

            await context.SaveChangesAsync();
            Logger.LogInformation("Successfully appended {RecordCount} records to local browser SQLite storage.", itemsToCache.Count);
        }
        catch (Exception ex)
        {            
            Logger.LogError(ex, "Background operation for local database cache update failed.");
        }
    }
}
