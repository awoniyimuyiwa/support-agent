@using Microsoft.AspNetCore.Components.Authorization

@*
  💡 DEPLOYMENT ARCHITECTURE NOTE:
  This file inside Web.Client is the single source of truth for app navigation.
  The matching 'NavMenu.razor' and 'NavMenu.razor.css' files located inside the Web server
  project path (Web/Components/Layout/) MUST BE COMPLETELY DELETED to avoid routing collisions.
*@

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Support Agent</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <!-- Authenticated User Workspace -->
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="dashboard">
                        <span class="bi bi-speedometer2" aria-hidden="true"></span> Dashboard
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="tickets">
                        <span class="bi bi-ticket-perforated-fill" aria-hidden="true"></span> My Tickets
                    </NavLink>
                </div>

                <!-- ADMIN SECTION: partitioned and hidden from standard support profiles -->
                <AuthorizeView Roles="@Domain.Shared.Constants.AdminRoleName" Context="adminContext">
                    <Authorized>
                        <div class="text-uppercase text-white-50 small fw-bold px-3 pt-3 pb-1"
                             style="font-size: 0.72rem; letter-spacing: 0.06em; opacity: 0.75;">
                            @Domain.Shared.Constants.AdminRoleName
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="admin">
                                <span class="bi bi-shield-lock-fill" aria-hidden="true"></span> Control Panel
                            </NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="admin/tickets">
                                <span class="bi bi-ticket-perforated-fill" aria-hidden="true"></span> Tickets
                            </NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="admin/document-categories">
                                <span class="bi bi-tags-fill" aria-hidden="true"></span> Document Categories
                            </NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="admin/documents">
                                <span class="bi bi-file-earmark-text-fill" aria-hidden="true"></span> Documents
                            </NavLink>
                        </div>
                    </Authorized>
                </AuthorizeView>
            </Authorized>
        </AuthorizeView>
    </nav>
</div>


