<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <div class="bg-primary-subtle text-primary rounded p-2.5 d-inline-flex align-items-center justify-content-center shadow-sm"
             style="min-width: 48px; min-height: 48px;">
            <span class="bi @IconClass fs-3" aria-hidden="true"></span>
        </div>
        
        <div>
            <h1 class="h3 fw-bold mb-0 text-dark">@Title</h1>
            <small class="text-secondary d-block mt-0.5">@Subtitle</small>
        </div>
    </div>
    
    <!-- Optional Render Slot for Action Buttons -->
    @if (ActionContent is not null)
    {
        <div class="d-flex align-items-center">
            @ActionContent
        </div>
    }
</div>

@code {

    /// <summary>
    /// The primary bold header text displayed on the layout screen.
    /// </summary>
    [Parameter, EditorRequired] 
    public string Title { get; set; } = string.Empty;

    /// <summary>
    /// The descriptive sub-text content rendered beneath the primary header.
    /// </summary>
    [Parameter, EditorRequired] 
    public string Subtitle { get; set; } = string.Empty;

    /// <summary>
    /// The CSS class name pointing to a target Bootstrap Icon font glyph (e.g., "bi-tags-fill").
    /// </summary>
    [Parameter] 
    public string IconClass { get; set; } = "bi-app-indicator";

    /// <summary>
    /// Captures markup layout button trees injected inside the component tags.
    /// </summary>
    [Parameter] 
    public RenderFragment? ActionContent { get; set; }
}
