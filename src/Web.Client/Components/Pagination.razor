<div class="d-flex justify-content-between align-items-center p-1">
    <div class="small text-secondary fw-semibold">
        Showing rows @((PageNumber - 1) * PageSize + 1) to @(Math.Min(PageNumber * PageSize, TotalCount)) of @TotalCount entries
    </div>
    
    @if (TotalPages > 1)
    {
        <nav aria-label="Page navigation">
            <ul class="pagination pagination-sm mb-0 shadow-sm border-0">
                <!-- Previous Button -->
                <li class="page-item @(PageNumber == 1 ? "disabled" : "")">
                    <button type="button" class="page-link" @onclick="() => UpdatePage(PageNumber - 1)" disabled="@(PageNumber == 1)">
                        <span class="bi bi-chevron-left" aria-hidden="true"></span>
                    </button>
                </li>

                <!-- Numbered Page Loops -->
                @for (int i = 1; i <= TotalPages; i++)
                {
                    var pageIndex = i;
                    <li class="page-item @(PageNumber == pageIndex ? "active" : "")">
                        <button type="button" class="page-link px-3 fw-bold" @onclick="() => UpdatePage(pageIndex)">
                            @pageIndex
                        </button>
                    </li>
                }

                <!-- Next Button -->
                <li class="page-item @(PageNumber == TotalPages ? "disabled" : "")">
                    <button type="button" class="page-link" @onclick="() => UpdatePage(PageNumber + 1)" disabled="@(PageNumber == TotalPages)">
                        <span class="bi bi-chevron-right" aria-hidden="true"></span>
                    </button>
                </li>
            </ul>
        </nav>
    }
</div>

@code {
    [Parameter, EditorRequired] public int PageNumber { get; set; }
    [Parameter, EditorRequired] public int PageSize { get; set; }
    [Parameter, EditorRequired] public int TotalCount { get; set; }

    [Parameter] public EventCallback<int> PageNumberChanged { get; set; }
    [Parameter] public EventCallback<int> OnPageChanged { get; set; }

    private int TotalPages => (int)Math.Ceiling((double)TotalCount / PageSize) is var pages and > 0 ? pages : 1;

    private async Task UpdatePage(int targetedPage)
    {
        if (targetedPage < 1 || targetedPage > TotalPages || targetedPage == PageNumber) return;

        // Supports standard Blazor two-way data-binding (@bind-PageNumber)
        await PageNumberChanged.InvokeAsync(targetedPage);
        
        // Triggers the data-reloading pipeline filter in the parent component
        await OnPageChanged.InvokeAsync(targetedPage);
    }
}
