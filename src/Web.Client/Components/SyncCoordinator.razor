@* Force Interactive Auto with no server-side pre-rendering since this should run only in the browser*@
@rendermode @(new InteractiveAutoRenderMode(prerender: false))

@using System.Collections.Immutable
@using System.Net
@using Api.Contracts
@using Microsoft.AspNetCore.Components.Authorization
@using Web.Client.Data
@using Web.Client.Extensions
@using Web.Client.Models;
@using Web.Client.Services

@inject ApiClient ApiClient
@inject IJSRuntime JS
@inject SyncService SyncService
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<SyncCoordinator> Logger
@inject NavigationManager Nav

@implements IDisposable

@if (_isSyncing)
{
    <div class="position-fixed bottom-0 end-0 m-3 p-3 bg-primary text-white rounded shadow-lg" style="z-index: 9999;">
        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
        Synchronizing offline updates with server...
    </div>
}

@if (_showRaceConditionAlert)
{
    <!-- Wrapped inside a fixed layout viewport panel container to float cleanly over any page -->
    <div class="position-fixed bottom-0 start-0 m-4 z-3 animate-fade-in" style="max-width: 440px; z-index: 9999;">
        <div class="alert alert-warning border-warning shadow-lg p-4 mb-0 d-flex align-items-start gap-3 bg-white">
            <span class="bi bi-arrow-clockwise fs-3 text-warning mt-1 flex-shrink-0 animate-spin"></span>
            <div class="flex-grow-1">
                <h6 class="fw-bold text-dark mb-1">Workspace Sync Paused</h6>
                <p class="text-secondary small mb-3">
                    Another user updated these records on the server while you were offline.
                    Please pull down fresh cloud data to review and merge your data.
                </p>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-warning btn-sm fw-bold px-3 shadow-sm" @onclick="HandleManualRefresh" disabled="@_isRefreshing">
                        @if (_isRefreshing)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Refreshing...</span>
                        }
                        else
                        {
                            <span>Pull Server Updates</span>
                        }
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3" @onclick="() => _showRaceConditionAlert = false">
                        Dismiss
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<AuthorizeView Roles="@Domain.Shared.Constants.AdminRoleName" Context="adminContext">
    <Authorized>
        <ConflictResolutionModal TItem="DocumentCategory"
                                 TKey="Guid"
                                 IsOpen="_showDocumentCategoryModal"
                                 Conflicts="_documentCategoryConflicts"
                                 KeySelector="@(dc => dc.Id)"
                                 DescriptionText="Document category values differ across attributes. Choose which specific values to preserve for each row attribute field:"
                                 OnCancel="CancelDocumentCategories"
                                 OnResolve="ApplyDocumentCategoryResolutions">
            <ItemHeader Context="documentCategory">
                <h6 class="mb-0 fw-bold text-primary">@documentCategory.Name</h6>
                <small class="text-muted font-monospace text-uppercase" style="font-size: 0.65rem;">Id: @documentCategory.Id</small>
            </ItemHeader>
        </ConflictResolutionModal>

        <ConflictResolutionModal TItem="Document"
                                 TKey="Guid"
                                 IsOpen="_showDocumentModal"
                                 Conflicts="_documentConflicts"
                                 KeySelector="@(d => d.Id)"
                                 DescriptionText="Document values differ across attributes. Choose which specific values to preserve for each row attribute field:"
                                 OnCancel="CancelDocuments"
                                 OnResolve="ApplyDocumentResolutions">
            <ItemHeader Context="document">
                <h6 class="mb-0 fw-bold text-primary">@document.Name</h6>
                <small class="text-muted font-monospace text-uppercase" style="font-size: 0.65rem;">Id: @document.Id</small>
            </ItemHeader>
        </ConflictResolutionModal>

        <ConflictResolutionModal TItem="DocumentVersion"
                                 TKey="Guid"
                                 IsOpen="_showDocumentVersionModal"
                                 Conflicts="_documentVersionConflicts"
                                 KeySelector="@(dv => dv.Id)"
                                 DescriptionText="Document version values differ across attributes. Choose which specific values to preserve for each row attribute field:"
                                 OnCancel="CancelDocumentVersions"
                                 OnResolve="ApplyDocumentVersionResolutions">
            <ItemHeader Context="documentVersion">
                <small class="text-muted font-monospace text-uppercase" style="font-size: 0.65rem;">Id: @documentVersion.Id</small>
            </ItemHeader>
        </ConflictResolutionModal>
    </Authorized>
</AuthorizeView>

<ConflictResolutionModal TItem="Ticket"
                         TKey="Guid"
                         IsOpen="_showTicketModal"
                         Conflicts="_ticketConflicts"
                         KeySelector="@(t => t.Id)"
                         DescriptionText="Ticket values differ across attributes. Choose which specific values to preserve for each row attribute field:"
                         OnCancel="CancelTickets"
                         OnResolve="ApplyTicketResolutions">
    <ItemHeader Context="ticket">
        <h6 class="mb-0 fw-bold text-primary">@ticket.Title</h6>
        <small class="text-muted font-monospace text-uppercase" style="font-size: 0.65rem;">Id: @ticket.Id</small>
    </ItemHeader>
</ConflictResolutionModal>

@code {
    private DotNetObjectReference<SyncCoordinator>? _objRef;

    private PeriodicTimer? _refreshTimer;

    private CancellationTokenSource? _cts;

    private IJSObjectReference? _networkModule;

    private bool _isSyncing = false;

    private bool _isOnline = true;

    private bool _isDisposed = false;

    private bool _showRaceConditionAlert = false;

    private bool _isRefreshing = false;

    // Document conflict States
    private bool _showDocumentModal = false;
    private IReadOnlyCollection<(Document Client, Document Server)> _documentConflicts = [];

    // Document category conflict States
    private bool _showDocumentCategoryModal = false;
    private IReadOnlyCollection<(DocumentCategory Client, DocumentCategory Server)> _documentCategoryConflicts = [];

    // Document version conflict States
    private bool _showDocumentVersionModal = false;
    private IReadOnlyCollection<(DocumentVersion Client, DocumentVersion Server)> _documentVersionConflicts = [];

    // Ticket conflict States
    private bool _showTicketModal = false;
    private IReadOnlyCollection<(Ticket Client, Ticket Server)> _ticketConflicts = [];

    public void Dispose()
    {
        _isDisposed = true;
        _cts?.Cancel();
        _cts?.Dispose();
        _refreshTimer?.Dispose();
        _objRef?.Dispose();

        if (_networkModule is not null
            && OperatingSystem.IsBrowser())
        {
            _ = UnregisterNetworkListenersAsync(_networkModule);
            _networkModule = null;
        }

        GC.SuppressFinalize(this);
    }

    [JSInvokable]
    public async Task OnConnectionStatusChanged(bool onlineStatus)
    {
        if (_isDisposed) { return; }

        _isOnline = onlineStatus;
        if (_isOnline && await AuthStateProvider.IsAuthenticated())
        {
            await Sync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) { return; }

        try
        {
            _objRef = DotNetObjectReference.Create(this);

            _networkModule = await JS.InvokeAsync<IJSObjectReference>("import", "./networkListener.js");
            _isOnline = await _networkModule.InvokeAsync<bool>("registerNetworkListener", _objRef);

            if (_isOnline && await AuthStateProvider.IsAuthenticated())
            {
                await Sync();
            }

            _cts = new CancellationTokenSource();
            _refreshTimer = new PeriodicTimer(TimeSpan.FromMinutes(10));
            _ = StartBackgroundSessionRefreshLoop(_cts.Token);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to initialize global sync coordinator.");
        }
    }

    private async Task ApplyTicketResolutions(
        IReadOnlyDictionary<Guid, IReadOnlyDictionary<string, ResolutionChoice>> decisions)
    {
        _showTicketModal = false;

        var serverRecords = _ticketConflicts
        .Select(x => x.Server)
        .ToImmutableList();

        await SyncService.ApplyResolutions<Ticket>(
            decisions,
            serverRecords,
            ctx => ctx.Tickets);

        await Sync();
    }

    private async Task ApplyDocumentResolutions(
        IReadOnlyDictionary<Guid, IReadOnlyDictionary<string, ResolutionChoice>> decisions)
    {
        _showDocumentModal = false;

        var serverRecords = _documentConflicts
        .Select(x => x.Server)
        .ToList();

        await SyncService.ApplyResolutions<Document>(
            decisions,
            serverRecords,
            ctx => ctx.Documents);

        await Sync();
    }

    private async Task ApplyDocumentCategoryResolutions(
        IReadOnlyDictionary<Guid, IReadOnlyDictionary<string, ResolutionChoice>> decisions)
    {
        _showDocumentCategoryModal = false;

        var serverRecords = _documentCategoryConflicts
        .Select(x => x.Server)
        .ToList();

        await SyncService.ApplyResolutions<DocumentCategory>(
            decisions,
            serverRecords,
            ctx => ctx.DocumentCategories);

        await Sync();
    }

    private async Task ApplyDocumentVersionResolutions(
        IReadOnlyDictionary<Guid, IReadOnlyDictionary<string, ResolutionChoice>> decisions)
    {
        _showDocumentVersionModal = false;

        var serverRecords = _documentVersionConflicts
        .Select(x => x.Server)
        .ToList();

        await SyncService.ApplyResolutions<DocumentVersion>(
            decisions,
            serverRecords,
            ctx => ctx.DocumentVersions);

        await Sync();
    }

    private void CancelDocuments() => _showDocumentModal = false;

    private void CancelDocumentCategories() => _showDocumentCategoryModal = false;

    private void CancelDocumentVersions() => _showDocumentVersionModal = false;

    private void CancelTickets() => _showTicketModal = false;

    private async Task HandleManualRefresh()
    {
        if (_isRefreshing
            || _isDisposed) { return; }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!authState.User.IsAuthenticated)
        {
            return;
        }

        try
        {
            _isRefreshing = true;
            StateHasChanged();

            await SyncService.FetchTicketDeltas();
            if (authState.User.IsAdmin)
            {
                await SyncService.FetchDocumentCategoryDeltas();
                await SyncService.FetchDocumentDeltas();
                await SyncService.FetchDocumentVersionDeltas();
            }

            _showRaceConditionAlert = false;

            // Re-render
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, ex.Message);
        }
        finally
        {
            _isRefreshing = false;
            StateHasChanged();
        }
    }

    private async Task StartBackgroundSessionRefreshLoop(CancellationToken cancellationToken)
    {
        try
        {
            while (await _refreshTimer!.WaitForNextTickAsync(cancellationToken))
            {
                if (_isDisposed) { break; }
                if (!_isOnline) { continue; }

                // If the user isn't logged in, skip the network call entirely
                if (!await AuthStateProvider.IsAuthenticated())
                {
                    Logger.LogDebug("User is anonymous. Skipping background keepalive sync.");
                    continue;
                }

                try
                {
                    var response = await ApiClient.GetUserInfoResponse(cancellationToken);

                    // Handle expected statuses gracefully as logical paths, not crashes
                    if (response.StatusCode == HttpStatusCode.Unauthorized)
                    {
                        Logger.LogInformation("Session expired. Forcing re-authentication.");

                        // Clear local application states here if needed (e.g. SQLite flags)

                        // Force a hard browser load to clear the .NET 10 in-memory auth state
                        Nav.NavigateTo("/login", forceLoad: true);
                        break;
                    }
                    else if (response.IsSuccessStatusCode)
                    {
                        Logger.LogInformation("Authentication cookie session successfully extended.");
                        await Sync();
                    }
                    else
                    {
                        Logger.LogWarning("Unexpected keepalive response: {StatusCode}", response.StatusCode);
                    }
                }
                catch (HttpRequestException ex)
                {
                    Logger.LogError(ex, ex.Message);
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Clean teardown when app token cancel routine executes smoothly on component dispose
        }
    }


    private async Task Sync()
    {
        if (_isSyncing
            || !_isOnline
            || _isDisposed) return;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!authState.User.IsAuthenticated)
        {
            return;
        }

        try
        {
            _isSyncing = true;
            StateHasChanged();

            bool hasMoreData = true;

            // Keep execution sweeping through database pages until no records remain pending
            while (hasMoreData && _isOnline && !_isDisposed)
            {
                var processedUserSync = await RunSync();

                var processedAdminSync = false;
                if (authState.User.IsAdmin)
                {
                    processedAdminSync = await RunAllSync();
                }

                // Determine if any operations processed data (implying there might be more batches)
                hasMoreData = processedUserSync || processedAdminSync;

                // Stop looping immediately if a conflict modal opened to wait for user choice
                if (_showTicketModal 
                    || _showDocumentModal 
                    || _showDocumentCategoryModal 
                    || _showDocumentVersionModal)
                {
                    break;
                }

                if (hasMoreData)
                {
                    // Throttling step: Yield thread to keep Blazor fluid and let network rest
                    await Task.Delay(200, _cts?.Token ?? default);
                }
            }
        }
        catch (HttpRequestException ex)
        {
            if (ex.StatusCode == HttpStatusCode.Conflict)
            {
                _showRaceConditionAlert = true;
                Logger.LogError(ex, ex.Message);
            }
            else
            {
                Logger.LogError(ex, ex.Message);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, ex.Message);
        }
        finally
        {
            _isSyncing = false;
            StateHasChanged();
        }
    }

    private async Task<bool> RunSync()
    {
        var ticketConflicts = await SyncService.Sync<Ticket>(
            ctx => ctx.Tickets,
            SyncService.SyncTickets);

        if (ticketConflicts.Any())
        {
            _ticketConflicts = ticketConflicts;
            _showTicketModal = true;
            return true; // Records were active
        }

        // Fetch changes
        await SyncService.FetchTicketDeltas();

        // Return true if any local updates were pushed out (checks batch count bounds)
        return ticketConflicts.Count >= Constants.MaxLengthOfList;
    }

    private async Task<bool> RunAllSync()
    {
        var entitiesProcessed = false;

        var documentCategoryConflicts = await SyncService.Sync<DocumentCategory>(
            ctx => ctx.DocumentCategories,
            SyncService.SyncDocumentCategories);
        if (documentCategoryConflicts.Any())
        {
            _documentCategoryConflicts = documentCategoryConflicts;
            _showDocumentCategoryModal = true;
            entitiesProcessed = true;
        }
        await SyncService.FetchDocumentCategoryDeltas();
        if (documentCategoryConflicts.Count >= Constants.MaxLengthOfList) entitiesProcessed = true;

        var documentConflicts = await SyncService.Sync<Document>(
            ctx => ctx.Documents,
            SyncService.SyncDocuments);
        if (documentConflicts.Any())
        {
            _documentConflicts = documentConflicts;
            _showDocumentModal = true;
            entitiesProcessed = true;
        }
        await SyncService.FetchDocumentDeltas();
        if (documentConflicts.Count >= Constants.MaxLengthOfList) entitiesProcessed = true;

        entitiesProcessed = await SyncService.CreateDocumentVersions();

        var documentVersionConflicts = await SyncService.Sync<DocumentVersion>(
                ctx => ctx.DocumentVersions,
                SyncService.SyncDocumentVersions);
        if (documentVersionConflicts.Any())
        {
            _documentVersionConflicts = documentVersionConflicts;
            _showDocumentVersionModal = true;
            entitiesProcessed = true;
        }
        await SyncService.FetchDocumentVersionDeltas();
        if (documentVersionConflicts.Count >= Constants.MaxLengthOfList) entitiesProcessed = true;

        return entitiesProcessed;
    }

    private async Task UnregisterNetworkListenersAsync(IJSObjectReference module)
    {
        try
        {
            await module.InvokeVoidAsync("unregisterNetworkListener");
            await module.DisposeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, ex.Message);
        }
    }
}

